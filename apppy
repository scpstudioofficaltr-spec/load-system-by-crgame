import tkinter as tk

WHITE = "#ffffff"
RED = "#e10600"
DARK = "#111111"
GREY = "#666666"
LIGHT = "#f6f6f6"
LINE = "#e5e5e5"


def build(root):
    root.title("LOAD SYSTEM")
    root.configure(bg=WHITE)
    for w in root.winfo_children():
        w.destroy()

    # Üst menü
    nav = tk.Frame(root, bg=WHITE, highlightbackground=LINE, highlightthickness=1)
    nav.pack(fill="x", side="top")
    tk.Label(nav, text="LOAD SYSTEM", fg=RED, bg=WHITE,
             font=("Segoe UI", 16, "bold")).pack(side="left", padx=24, pady=14)
    for item in ("İletişim", "Hakkında", "Ana Sayfa"):
        tk.Label(nav, text=item, fg=DARK, bg=WHITE, font=("Segoe UI", 11),
                 cursor="hand2").pack(side="right", padx=16)

    # Kaydırılabilir gövde
    body = tk.Frame(root, bg=WHITE)
    body.pack(fill="both", expand=True)

    canvas = tk.Canvas(body, bg=WHITE, highlightthickness=0)
    sb = tk.Scrollbar(body, orient="vertical", command=canvas.yview)
    sb.pack(side="right", fill="y")
    canvas.pack(side="left", fill="both", expand=True)
    canvas.configure(yscrollcommand=sb.set)

    page = tk.Frame(canvas, bg=WHITE)
    win = canvas.create_window((0, 0), window=page, anchor="nw")
    page.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
    canvas.bind("<Configure>", lambda e: canvas.itemconfigure(win, width=e.width))
    canvas.bind_all("<MouseWheel>", lambda e: canvas.yview_scroll(int(-e.delta / 120), "units"))

    # Hero bölümü
    hero = tk.Frame(page, bg=WHITE)
    hero.pack(fill="x", padx=60, pady=(70, 40))
    tk.Label(hero, text="Hoş geldin", fg=RED, bg=WHITE,
             font=("Segoe UI", 12, "bold")).pack(anchor="w")
    tk.Label(hero, text="Sistemin tek ekranda", fg=DARK, bg=WHITE,
             font=("Segoe UI", 38, "bold")).pack(anchor="w", pady=(6, 0))
    tk.Label(hero, text="Tüm araçlar, bağlantılar ve bilgiler tek bir pencerede.",
             fg=GREY, bg=WHITE, font=("Segoe UI", 13)).pack(anchor="w", pady=(10, 24))
    tk.Button(hero, text="Başla", fg=WHITE, bg=RED, activebackground="#b80500",
              activeforeground=WHITE, relief="flat", font=("Segoe UI", 12, "bold"),
              padx=28, pady=10, cursor="hand2").pack(anchor="w")

    # Kartlar
    cards = tk.Frame(page, bg=WHITE)
    cards.pack(fill="x", padx=60, pady=20)
    items = [
        ("Hızlı Erişim", "Sık kullanılan işlemlere tek tıkla ulaş."),
        ("Güvenli Yapı", "Verilerin yerel olarak işlenir ve korunur."),
        ("Sade Tasarım", "Dağınıklık yok, yalnızca ihtiyacın olanlar."),
    ]
    for i, (title, text) in enumerate(items):
        card = tk.Frame(cards, bg=LIGHT, highlightbackground=LINE, highlightthickness=1)
        card.grid(row=0, column=i, padx=10, sticky="nsew")
        cards.grid_columnconfigure(i, weight=1)
        tk.Frame(card, bg=RED, height=4).pack(fill="x")
        tk.Label(card, text=title, fg=DARK, bg=LIGHT,
                 font=("Segoe UI", 15, "bold")).pack(anchor="w", padx=20, pady=(20, 6))
        tk.Label(card, text=text, fg=GREY, bg=LIGHT, font=("Segoe UI", 11),
                 wraplength=260, justify="left").pack(anchor="w", padx=20, pady=(0, 24))

    # İçerik bölümü
    section = tk.Frame(page, bg=WHITE)
    section.pack(fill="x", padx=60, pady=(50, 20))
    tk.Label(section, text="Hakkında", fg=DARK, bg=WHITE,
             font=("Segoe UI", 22, "bold")).pack(anchor="w")
    tk.Label(section,
             text=("Bu ekran, uygulamanın ana arayüzüdür. Pencere büyütülmüş olarak açılır "
                   "ve içerik, sayfa gibi aşağı doğru kaydırılabilir. Arayüzü değiştirmek "
                   "için bu dosyadaki build fonksiyonunu düzenlemen yeterlidir."),
             fg=GREY, bg=WHITE, font=("Segoe UI", 12), wraplength=900,
             justify="left").pack(anchor="w", pady=(10, 0))

    # Alt bilgi
    footer = tk.Frame(page, bg=LIGHT, highlightbackground=LINE, highlightthickness=1)
    footer.pack(fill="x", side="bottom", pady=(60, 0))
    tk.Label(footer, text="© LOAD SYSTEM", fg=GREY, bg=LIGHT,
             font=("Segoe UI", 10)).pack(pady=18)
