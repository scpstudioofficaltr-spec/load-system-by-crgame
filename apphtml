<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AURA | Yaratıcı İlham & Renk Stüdyosu</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & Space Grotesk -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <!-- Tone.js for Interactive Sound Effects -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>

    <style>
        /* Özel Kaydırma Çubuğu ve Temel Animasyonlar */
        body {
            font-family: 'Inter', sans-serif;
            transition: background-color 0.7s ease, color 0.5s ease;
            overflow-x: hidden;
        }

        h1, h2, h3, .font-display {
            font-family: 'Space Grotesk', sans-serif;
        }

        /* Arka Plan Neon Küre Animasyonu */
        @keyframes float {
            0%, 100% { transform: translate(0px, 0px) scale(1); }
            33% { transform: translate(30px, -40px) scale(1.05); }
            66% { transform: translate(-20px, 20px) scale(0.95); }
        }

        .orb {
            animation: float 14s infinite ease-in-out;
            filter: blur(80px);
            opacity: 0.45;
            pointer-events: none;
        }

        .orb-delay {
            animation-delay: -7s;
        }

        /* Renk Kartı Hover Efekti */
        .color-card {
            transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .color-card:hover {
            transform: translateY(-6px) scale(1.02);
        }

        /* Refleks Oyunu Hedef Animasyonu */
        @keyframes pulseTarget {
            0% { transform: scale(0.85); box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 18px rgba(56, 189, 248, 0); }
            100% { transform: scale(0.85); box-shadow: 0 0 0 0 rgba(56, 189, 248, 0); }
        }

        .neon-target {
            animation: pulseTarget 1.5s infinite;
        }

        /* Cam Efekti (Glassmorphism) */
        .glass-panel {
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen relative selection:bg-cyan-500 selection:text-slate-950">

    <!-- Arka Plan Dinamik Neon Işık Küreleri -->
    <div id="orb1" class="orb fixed top-10 left-10 w-72 h-72 md:w-96 md:h-96 rounded-full bg-cyan-500 z-0"></div>
    <div id="orb2" class="orb orb-delay fixed bottom-10 right-10 w-80 h-80 md:w-[28rem] md:h-[28rem] rounded-full bg-fuchsia-600 z-0"></div>

    <!-- Bildirim Kutusu (Toast Notification - alert() yerine) -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="glass-panel bg-slate-900/90 border border-cyan-400/50 text-white px-5 py-3 rounded-2xl shadow-2xl flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-ping"></span>
            <span id="toast-message" class="text-sm font-medium">Renk kodu kopyalandı!</span>
        </div>
    </div>

    <!-- Ana Taşıyıcı -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col min-h-screen">

        <!-- Üst Menü / Header -->
        <header class="flex flex-wrap items-center justify-between gap-4 pb-8 border-b border-white/10">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-400 to-fuchsia-500 flex items-center justify-center shadow-lg shadow-cyan-500/20">
                    <svg class="w-6 h-6 text-slate-950" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white to-slate-400">
                        AURA <span class="text-cyan-400 font-normal">STÜDYO</span>
                    </h1>
                    <p class="text-xs text-slate-400">Yaratıcı İlham, Renk & Refleks Alanı</p>
                </div>
            </div>

            <!-- Kontrol Butonları -->
            <div class="flex items-center gap-2 sm:gap-3">
                <!-- Ses Aç/Kapat -->
                <button id="soundToggle" onclick="toggleSound()" title="Ses Efektlerini Aç/Kapat"
                    class="p-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 transition flex items-center gap-2 text-xs sm:text-sm">
                    <span id="soundIcon">🔊</span>
                    <span class="hidden sm:inline text-slate-300">Ses Açık</span>
                </button>

                <!-- Arka Plan Atmosferi Değiştir -->
                <button onclick="cycleBackground()"
                    class="px-3.5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 transition flex items-center gap-2 text-xs sm:text-sm font-medium text-slate-200">
                    <span>🌌</span>
                    <span>Atmosfer</span>
                </button>
            </div>
        </header>

        <!-- Sekme Navigasyonu (Stüdyo vs Mini Refleks Oyunu) -->
        <nav class="flex gap-2 my-6 p-1.5 rounded-2xl bg-white/5 border border-white/10 w-fit mx-auto sm:mx-0">
            <button id="tabStudio" onclick="switchTab('studio')"
                class="px-5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-gradient-to-r from-cyan-500 to-blue-600 text-white shadow-lg shadow-cyan-500/25">
                🎨 İlham & Renk Paleti
            </button>
            <button id="tabGame" onclick="switchTab('game')"
                class="px-5 py-2.5 rounded-xl text-sm font-semibold transition-all text-slate-400 hover:text-white">
                ⚡ Neon Refleks Oyunu
            </button>
        </nav>

        <!-- BÖLÜM 1: İLHAM & RENK PALETİ STÜDYOSU -->
        <main id="studioSection" class="flex-1 flex flex-col gap-8 transition-opacity duration-300">

            <!-- Günlük İlham Kartı -->
            <section class="glass-panel bg-white/[0.04] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-fuchsia-500/20 text-fuchsia-300 border border-fuchsia-500/30 w-fit">
                        ✨ GÜNÜN İLHAMI
                    </span>
                    <span id="quoteCategory" class="text-xs text-slate-400 uppercase tracking-widest">Tasarım & Vizyon</span>
                </div>

                <blockquote id="quoteText" class="text-xl sm:text-2xl md:text-3xl font-display font-medium leading-relaxed text-white my-4 transition-all duration-300">
                    "Basitlik, karmaşıklığın en yüksek noktasıdır. Az olan her zaman daha derin iz bırakır."
                </blockquote>

                <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-white/10">
                    <p id="quoteAuthor" class="text-sm text-cyan-400 font-medium">— Leonardo da Vinci</p>

                    <div class="flex items-center gap-2">
                        <button onclick="copyQuote()"
                            class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs sm:text-sm font-medium transition active:scale-95">
                            📋 Sözü Kopyala
                        </button>
                        <button onclick="generateQuote()"
                            class="px-4 py-2 rounded-xl bg-fuchsia-600 hover:bg-fuchsia-500 text-white text-xs sm:text-sm font-semibold shadow-lg shadow-fuchsia-600/30 transition active:scale-95">
                            🔄 Yeni İlham Al
                        </button>
                    </div>
                </div>
            </section>

            <!-- Etkileşimli Neon Renk Paleti Üretici -->
            <section class="glass-panel bg-white/[0.04] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
                            <span>🎨</span> Dinamik Renk Paleti
                        </h2>
                        <p class="text-xs sm:text-sm text-slate-400 mt-1">
                            Kopyalamak için rengin üzerine tıkla, kilitlemek için kilit simgesini kullan.
                        </p>
                    </div>

                    <button onclick="generatePalette()"
                        class="px-5 py-3 rounded-2xl bg-gradient-to-r from-cyan-500 to-emerald-500 hover:from-cyan-400 hover:to-emerald-400 text-slate-950 font-bold text-sm shadow-lg shadow-cyan-500/25 transition transform active:scale-95 flex items-center justify-center gap-2">
                        <span>🎲</span> Yeni Palet Üret <span class="hidden md:inline text-xs opacity-75">(Boşluk Tuşu)</span>
                    </button>
                </div>

                <!-- 5'li Renk Kartları Grid -->
                <div id="paletteGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                    <!-- JavaScript ile dinamik oluşturulacak -->
                </div>
            </section>
        </main>

        <!-- BÖLÜM 2: MİNİ NEON REFLEKS OYUNU -->
        <section id="gameSection" class="hidden flex-1 flex-col gap-6">
            <div class="glass-panel bg-white/[0.04] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl flex flex-col">
                
                <!-- Oyun Üst Bilgi Paneli -->
                <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <span>⚡</span> Neon Refleks Arenası
                        </h2>
                        <p class="text-xs sm:text-sm text-slate-400">Parlayan neon hedeflere 20 saniye içinde olabildiğince hızlı dokun!</p>
                    </div>

                    <!-- Skor ve Süre Göstergeleri -->
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="px-4 py-2 rounded-2xl bg-slate-900/80 border border-white/10 text-center">
                            <div class="text-[10px] uppercase tracking-wider text-slate-400">Süre</div>
                            <div id="gameTimer" class="text-lg sm:text-xl font-bold text-cyan-400 font-display">20s</div>
                        </div>
                        <div class="px-4 py-2 rounded-2xl bg-slate-900/80 border border-white/10 text-center">
                            <div class="text-[10px] uppercase tracking-wider text-slate-400">Skor</div>
                            <div id="gameScore" class="text-lg sm:text-xl font-bold text-emerald-400 font-display">0</div>
                        </div>
                        <div class="px-4 py-2 rounded-2xl bg-slate-900/80 border border-white/10 text-center">
                            <div class="text-[10px] uppercase tracking-wider text-slate-400">Rekor</div>
                            <div id="gameHighScore" class="text-lg sm:text-xl font-bold text-fuchsia-400 font-display">0</div>
                        </div>
                    </div>
                </div>

                <!-- Oyun Alanı (Canvas yerine tamamen duyarlı etkileşimli arena) -->
                <div id="gameArena" class="relative w-full h-72 sm:h-96 rounded-2xl bg-slate-900/90 border border-white/10 overflow-hidden flex items-center justify-center select-none">
                    
                    <!-- Başlangıç / Bitiş Ekranı Katmanı -->
                    <div id="gameOverlay" class="text-center p-6 z-10 flex flex-col items-center gap-4">
                        <div class="w-16 h-16 rounded-full bg-cyan-500/20 border border-cyan-400/50 flex items-center justify-center text-3xl animate-bounce">
                            🎯
                        </div>
                        <h3 id="gameStatusTitle" class="text-xl sm:text-2xl font-bold text-white">Reflekslerini Test Et!</h3>
                        <p id="gameStatusDesc" class="text-sm text-slate-400 max-w-md">
                            Ekranda beliren neon kürelere tıklayarak veya dokunarak puan topla. Ne kadar hızlı olursan o kadar yüksek skor yaparsın!
                        </p>
                        <button onclick="startGame()"
                            class="mt-2 px-7 py-3.5 rounded-2xl bg-gradient-to-r from-cyan-500 to-fuchsia-600 hover:from-cyan-400 hover:to-fuchsia-500 text-white font-bold text-sm shadow-lg shadow-cyan-500/30 transition transform active:scale-95">
                            🚀 Oyunu Başlat
                        </button>
                    </div>

                    <!-- Dinamik Neon Hedef Butonu -->
                    <button id="neonTarget" onclick="hitTarget(event)"
                        class="hidden absolute w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-gradient-to-tr from-cyan-400 to-fuchsia-500 border-2 border-white shadow-lg neon-target cursor-pointer transform -translate-x-1/2 -translate-y-1/2 active:scale-75 transition-transform"
                        aria-label="Hedef">
                    </button>
                </div>
            </div>
        </section>

        <!-- Alt Bilgi (Footer) -->
        <footer class="mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-500">
            <p>© 2026 AURA Stüdyo — Etkileşimli Dijital Deneyim</p>
            <p>İpucu: Yeni renk paleti için klavyeden <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-slate-300">Space</kbd> tuşuna basabilirsin.</p>
        </footer>
    </div>

    <!-- Pano Kopyalama için Gizli Textarea -->
    <textarea id="clipboardHelper" class="sr-only" aria-hidden="true"></textarea>

    <script>
        // ==========================================
        // 1. SES EFEKTLERİ (TONE.JS - HARİCİ DOSYA YOK)
        // ==========================================
        let soundEnabled = true;
        let synth = null;

        function initAudio() {
            if (!synth && typeof Tone !== 'undefined') {
                synth = new Tone.PolySynth(Tone.Synth, {
                    oscillator: { type: "sine" },
                    envelope: { attack: 0.01, decay: 0.15, sustain: 0.05, release: 0.3 }
                }).toDestination();
                synth.volume.value = -10;
            }
        }

        function playNote(note = "C5", duration = "16n") {
            if (!soundEnabled) return;
            try {
                initAudio();
                if (Tone.context.state !== 'running') {
                    Tone.start();
                }
                synth.triggerAttackRelease(note, duration);
            } catch (e) {
                // Tarayıcı ses politikası engellerse sessizce devam et
            }
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('soundIcon');
            const btnText = document.querySelector('#soundToggle span:last-child');
            if (soundEnabled) {
                icon.textContent = '🔊';
                if (btnText) btnText.textContent = 'Ses Açık';
                playNote("E5", "16n");
                showToast("Ses efektleri açıldı");
            } else {
                icon.textContent = '🔇';
                if (btnText) btnText.textContent = 'Ses Kapalı';
                showToast("Ses efektleri kapatıldı");
            }
        }

        // ==========================================
        // 2. BİLDİRİM VE PANO İŞLEMLERİ
        // ==========================================
        let toastTimeout;
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            toastMsg.textContent = message;

            toast.classList.remove('translate-y-24', 'opacity-0');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 2400);
        }

        function copyTextToClipboard(text, successMsg) {
            const helper = document.getElementById('clipboardHelper');
            helper.value = text;
            helper.select();
            try {
                document.execCommand('copy');
                playNote("G5", "16n");
                showToast(successMsg);
            } catch (err) {
                showToast("Kopyalama başarısız oldu.");
            }
        }

        // ==========================================
        // 3. ARKA PLAN ATMOSFER DEĞİŞTİRİCİ
        // ==========================================
        const atmospheres = [
            { bg: 'bg-slate-950', orb1: 'bg-cyan-500', orb2: 'bg-fuchsia-600', name: 'Siber Gece' },
            { bg: 'bg-indigo-950', orb1: 'bg-emerald-400', orb2: 'bg-violet-600', name: 'Kuzey Işıkları' },
            { bg: 'bg-zinc-950', orb1: 'bg-amber-500', orb2: 'bg-rose-600', name: 'Gün Batımı Neonu' },
            { bg: 'bg-neutral-950', orb1: 'bg-sky-400', orb2: 'bg-teal-500', name: 'Derin Okyanus' }
        ];
        let currentAtmIndex = 0;

        function cycleBackground() {
            const prev = atmospheres[currentAtmIndex];
            currentAtmIndex = (currentAtmIndex + 1) % atmospheres.length;
            const next = atmospheres[currentAtmIndex];

            document.body.classList.remove(prev.bg);
            document.body.classList.add(next.bg);

            const orb1 = document.getElementById('orb1');
            const orb2 = document.getElementById('orb2');
            orb1.classList.remove(prev.orb1);
            orb1.classList.add(next.orb1);
            orb2.classList.remove(prev.orb2);
            orb2.classList.add(next.orb2);

            playNote("A4", "16n");
            showToast(`Atmosfer: ${next.name}`);
        }

        // ==========================================
        // 4. İLHAM VERİCİ SÖZLER MODÜLÜ
        // ==========================================
        const quotes = [
            { text: "Basitlik, karmaşıklığın en yüksek noktasıdır. Az olan her zaman daha derin iz bırakır.", author: "Leonardo da Vinci", category: "Tasarım & Vizyon" },
            { text: "Geleceği tahmin etmenin en iyi yolu, onu bizzat tasarlamaktır.", author: "Alan Kay", category: "İnovasyon" },
            { text: "Yaratıcılık, zekânın eğleniyor halidir.", author: "Albert Einstein", category: "Yaratıcılık" },
            { text: "Her büyük tasarım, sıradan bir soruya verilen cesur bir yanıtla başlar.", author: "Anonim", category: "Minimalizm" },
            { text: "Mükemmellik, eklenecek bir şey kalmadığında değil, çıkarılacak bir şey kalmadığında elde edilir.", author: "Antoine de Saint-Exupéry", category: "Sanat & Denge" },
            { text: "Hayal edebildiğiniz her şey gerçektir; yeter ki ona bir renk ve form verin.", author: "Pablo Picasso", category: "İlham" },
            { text: "Küçük adımlar, tutarlılıkla birleştiğinde büyük devrimler yaratır.", author: "Modern Atasözü", category: "Motivasyon" }
        ];
        let lastQuoteIndex = 0;

        function generateQuote() {
            let idx;
            do {
                idx = Math.floor(Math.random() * quotes.length);
            } while (idx === lastQuoteIndex);
            lastQuoteIndex = idx;

            const q = quotes[idx];
            const quoteEl = document.getElementById('quoteText');
            quoteEl.style.opacity = '0';

            setTimeout(() => {
                quoteEl.textContent = `"${q.text}"`;
                document.getElementById('quoteAuthor').textContent = `— ${q.author}`;
                document.getElementById('quoteCategory').textContent = q.category;
                quoteEl.style.opacity = '1';
            }, 180);

            playNote("D5", "16n");
        }

        function copyQuote() {
            const text = document.getElementById('quoteText').textContent;
            const author = document.getElementById('quoteAuthor').textContent;
            copyTextToClipboard(`${text} ${author}`, "İlham sözü panoya kopyalandı!");
        }

        // ==========================================
        // 5. DİNAMİK RENK PALETİ ÜRETİCİ
        // ==========================================
        let palette = [
            { hex: '#06B6D4', locked: false },
            { hex: '#8B5CF6', locked: false },
            { hex: '#EC4899', locked: false },
            { hex: '#10B981', locked: false },
            { hex: '#F59E0B', locked: false }
        ];

        function randomNeonHex() {
            // Canlı ve modern tonlar için HSL'den HEX'e dönüşüm
            const h = Math.floor(Math.random() * 360);
            const s = Math.floor(Math.random() * 25) + 70; // %70 - %95 doygunluk
            const l = Math.floor(Math.random() * 25) + 45; // %45 - %70 parlaklık
            return hslToHex(h, s, l);
        }

        function hslToHex(h, s, l) {
            l /= 100;
            const a = s * Math.min(l, 1 - l) / 100;
            const f = n => {
                const k = (n + h / 30) % 12;
                const color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
                return Math.round(255 * color).toString(16).padStart(2, '0');
            };
            return `#${f(0)}${f(8)}${f(4)}`.toUpperCase();
        }

        function generatePalette(isInitial = false) {
            palette = palette.map(item => ({
                hex: item.locked ? item.hex : randomNeonHex(),
                locked: item.locked
            }));
            renderPalette();
            if (!isInitial) {
                playNote("C5", "16n");
            }
        }

        function toggleLock(index, event) {
            event.stopPropagation();
            palette[index].locked = !palette[index].locked;
            renderPalette();
            playNote(palette[index].locked ? "E4" : "G4", "32n");
            showToast(palette[index].locked ? `${palette[index].hex} kilitlendi` : `${palette[index].hex} kilidi açıldı`);
        }

        function renderPalette() {
            const grid = document.getElementById('paletteGrid');
            grid.innerHTML = '';

            palette.forEach((color, index) => {
                const card = document.createElement('div');
                card.className = 'color-card group relative rounded-2xl overflow-hidden border border-white/15 bg-slate-900/60 cursor-pointer flex flex-col justify-between h-36 sm:h-48 shadow-lg';
                card.onclick = () => copyTextToClipboard(color.hex, `${color.hex} renk kodu kopyalandı!`);

                card.innerHTML = `
                    <div class="w-full flex-1 transition-colors duration-500 relative flex items-start justify-end p-3" style="background-color: ${color.hex};">
                        <button onclick="toggleLock(${index}, event)"
                            title="${color.locked ? 'Kilidi Aç' : 'Rengi Kilitle'}"
                            class="w-8 h-8 rounded-xl bg-slate-950/40 hover:bg-slate-950/70 backdrop-blur-md text-white flex items-center justify-center text-sm transition">
                            ${color.locked ? '🔒' : '🔓'}
                        </button>
                    </div>
                    <div class="p-3 bg-slate-950/90 flex items-center justify-between">
                        <span class="font-display font-bold text-sm tracking-wider text-white">${color.hex}</span>
                        <span class="text-[11px] text-slate-400 group-hover:text-cyan-400 transition">Kopyala</span>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Boşluk (Space) tuşu ile hızlı palet üretme
        document.addEventListener('keydown', (e) => {
            if (e.code === 'Space' && !document.getElementById('studioSection').classList.contains('hidden')) {
                e.preventDefault();
                generatePalette();
            }
        });

        // ==========================================
        // 6. SEKME GEÇİŞLERİ VE NEON REFLEKS OYUNU
        // ==========================================
        function switchTab(tab) {
            const studioSec = document.getElementById('studioSection');
            const gameSec = document.getElementById('gameSection');
            const tabStudio = document.getElementById('tabStudio');
            const tabGame = document.getElementById('tabGame');

            if (tab === 'studio') {
                studioSec.classList.remove('hidden');
                gameSec.classList.add('hidden');
                gameSec.classList.remove('flex');

                tabStudio.className = 'px-5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-gradient-to-r from-cyan-500 to-blue-600 text-white shadow-lg shadow-cyan-500/25';
                tabGame.className = 'px-5 py-2.5 rounded-xl text-sm font-semibold transition-all text-slate-400 hover:text-white';
            } else {
                studioSec.classList.add('hidden');
                gameSec.classList.remove('hidden');
                gameSec.classList.add('flex');

                tabGame.className = 'px-5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-gradient-to-r from-cyan-500 to-fuchsia-600 text-white shadow-lg shadow-fuchsia-500/25';
                tabStudio.className = 'px-5 py-2.5 rounded-xl text-sm font-semibold transition-all text-slate-400 hover:text-white';
            }
            playNote("F5", "32n");
        }

        let score = 0;
        let highScore = 0;
        let timeLeft = 20;
        let gameInterval = null;
        let isPlaying = false;

        function startGame() {
            score = 0;
            timeLeft = 20;
            isPlaying = true;

            document.getElementById('gameScore').textContent = score;
            document.getElementById('gameTimer').textContent = `${timeLeft}s`;
            document.getElementById('gameOverlay').classList.add('hidden');
            document.getElementById('neonTarget').classList.remove('hidden');

            moveTarget();
            playNote("C5", "16n");

            clearInterval(gameInterval);
            gameInterval = setInterval(() => {
                timeLeft--;
                document.getElementById('gameTimer').textContent = `${timeLeft}s`;

                if (timeLeft <= 0) {
                    endGame();
                }
            }, 1000);
        }

        function moveTarget() {
            const arena = document.getElementById('gameArena');
            const target = document.getElementById('neonTarget');

            const padding = 45;
            const maxX = arena.clientWidth - padding;
            const maxY = arena.clientHeight - padding;

            const randomX = Math.max(padding, Math.floor(Math.random() * maxX));
            const randomY = Math.max(padding, Math.floor(Math.random() * maxY));

            target.style.left = `${randomX}px`;
            target.style.top = `${randomY}px`;
        }

        function hitTarget(event) {
            if (!isPlaying) return;
            event.stopPropagation();

            score++;
            document.getElementById('gameScore').textContent = score;

            // Nota yüksekliğini skora göre hafifçe artır
            const notes = ["C5", "D5", "E5", "G5", "A5", "C6"];
            playNote(notes[score % notes.length], "32n");

            moveTarget();
        }

        function endGame() {
            isPlaying = false;
            clearInterval(gameInterval);

            document.getElementById('neonTarget').classList.add('hidden');
            const overlay = document.getElementById('gameOverlay');
            overlay.classList.remove('hidden');

            if (score > highScore) {
                highScore = score;
                document.getElementById('gameHighScore').textContent = highScore;
                document.getElementById('gameStatusTitle').textContent = `🎉 Yeni Rekor: ${score} Puan!`;
            } else {
                document.getElementById('gameStatusTitle').textContent = `Süre Doldu! Skorun: ${score}`;
            }

            document.getElementById('gameStatusDesc').textContent = "Harika refleksler! Kendi rekorunu kırmak için tekrar deneyebilirsin.";
            playNote("G4", "8n");
        }

        // Sayfa Yüklendiğinde Başlat
        window.onload = function () {
            generatePalette(true);
        };
    </script>
</body>
</html>
