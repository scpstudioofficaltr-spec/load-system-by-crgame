    def update(self, dt):
        if self.state == "play":
            self.update_play(dt)

    def draw(self):
        c = self.canvas
        c.delete("all")
        t = self.time_acc
        if self.state == "menu":
            self.draw_menu(c, t)
        elif self.state == "settings":
            self.draw_settings(c, t)
        elif self.state == "play":
            self.draw_play(c, t)
        elif self.state == "pause":
            self.draw_pause(c, t)
        elif self.state == "levelclear":
            self.draw_levelclear(c, t)
        elif self.state in ("gameover", "victory"):
            self.draw_gameover(c, t)
        for i, b in enumerate(self.buttons):
            b.draw(c, self.hover_idx == i)

    def loop(self):
        self.after_id = None
        try:
            now = time.time()
            dt = now - self.last_t
            self.last_t = now
            if dt > 0.05:
                dt = 0.05
            if dt < 0:
                dt = 0
            self.time_acc += dt
            self.update(dt)
            self.draw()
            self.frames += 1
            if now - self.fps_t >= 0.5:
                self.fps = self.frames / (now - self.fps_t)
                self.frames = 0
                self.fps_t = now
        except Exception:
            traceback.print_exc()
        finally:
            if self.running:
                try:
                    self.after_id = self.root.after(LOOP_MS, self.loop)
                except Exception:
                    traceback.print_exc()
                    self.running = False

    def start(self):
        self.last_t = time.time()
        self.fps_t = self.last_t
        try:
            self.after_id = self.root.after(LOOP_MS, self.loop)
        except Exception:
            traceback.print_exc()


