# --------------------------------------------------------------- renk araclar
def _hx(c):
    return int(c[1:3], 16), int(c[3:5], 16), int(c[5:7], 16)


def mix(a, b, t):
    ar, ag, ab = _hx(a)
    br, bg, bb = _hx(b)
    t = 0.0 if t < 0 else (1.0 if t > 1 else t)
    return "#%02x%02x%02x" % (int(ar + (br - ar) * t),
                               int(ag + (bg - ag) * t),
                               int(ab + (bb - ab) * t))


def shade(c, f):
    if f <= 1.0:
        return mix(c, "#000000", 1.0 - f)
    return mix(c, "#ffffff", min(1.0, f - 1.0))


def clamp(v, lo, hi):
    if v < lo:
        return lo
    if v > hi:
        return hi
    return v


def dist2(ax, ay, bx, by):
    dx = ax - bx
    dy = ay - by
    return dx * dx + dy * dy


# ------------------------------------------------------------- cizim araclari
def rounded_points(x1, y1, x2, y2, r, steps=6):
    r = max(0.0, min(r, (x2 - x1) / 2.0, (y2 - y1) / 2.0))
    pts = []
    specs = ((x2 - r, y1 + r, -90, 0),
             (x2 - r, y2 - r, 0, 90),
             (x1 + r, y2 - r, 90, 180),
             (x1 + r, y1 + r, 180, 270))
    for cx, cy, a0, a1 in specs:
        for i in range(steps + 1):
            a = math.radians(a0 + (a1 - a0) * i / steps)
            pts.append(cx + r * math.cos(a))
            pts.append(cy + r * math.sin(a))
    return pts


def soft_shadow(c, x1, y1, x2, y2, r, layers=3, base=C_SHADOW, bg=C_BG):
    for i in range(layers, 0, -1):
        o = i * 2.5
        col = mix(base, bg, 1.0 - (i - 1) / float(layers) * 0.72)
        c.create_polygon(rounded_points(x1 - o, y1 - o + 3, x2 + o, y2 + o + 3, r + o),
                         smooth=True, fill=col, outline="")


def panel(c, x1, y1, x2, y2, r=14, fill=C_PANEL, shadow=3, outline=None, ow=2):
    if shadow:
        soft_shadow(c, x1, y1, x2, y2, r, shadow)
    c.create_polygon(rounded_points(x1, y1, x2, y2, r), smooth=True, fill=fill,
                     outline=(outline or ""), width=(ow if outline else 0))


def txt(c, x, y, s, size=12, color=C_TEXT, anchor="center", bold=True):
    c.create_text(x, y, text=s, fill=color,
                  font=(F, size, "bold" if bold else "normal"), anchor=anchor)


def bar(c, x1, y, x2, h, ratio, fill=C_OK, bg="#141826", r=None):
    if r is None:
        r = h / 2.0
    c.create_polygon(rounded_points(x1, y, x2, y + h, r), smooth=True, fill=bg, outline="")
    w = (x2 - x1) * max(0.0, min(1.0, ratio))
    if w > 2:
        c.create_polygon(rounded_points(x1, y, x1 + w, y + h, r), smooth=True, fill=fill, outline="")
        if w > 14:
            c.create_polygon(rounded_points(x1 + 2, y + 2, x1 + w - 2, y + h * 0.45, r * 0.6),
                             smooth=True, fill=shade(fill, 1.22), outline="")


