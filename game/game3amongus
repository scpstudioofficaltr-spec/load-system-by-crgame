    def start_game(self):
        d = DIFFS[self.settings["diff"]]
        self.diff = d
        self.score = 0
        self.combo = 1
        self.combo_t = 0.0
        self.level_idx = 0
        self.wave_idx = 0
        self.player = Player(W / 2.0, H - 150)
        self.enemies = []
        self.pbullets = []
        self.ebullets = []
        self.particles = []
        self.pickups = []
        self.powerups = {"rapid": 0.0, "spread": 0.0, "shield": 0.0}
        self.fire_cd = 0.0
        self.fire_interval = 0.20
        self.spawn_queue = []
        self.spawn_t = 0.0
        self.wave_clear_t = 0.0
        self.contact_cd = 0.0
        self.banner = ""
        self.banner_t = 0.0
        self.game_time = 0.0
        self.shake = 0.0
        self.name_input = ""
        self.pending_score = None
        self.name_active = False
        self.start_level(0)
        self.enter_state("play")

    def start_level(self, idx):
        self.level_idx = idx
        self.wave_idx = 0
        self.enemies = []
        self.pbullets = []
        self.ebullets = []
        self.pickups = []
        self.spawn_queue = []
        self.spawn_t = 0.0
        self.wave_clear_t = 0.0
        self.player.hp = min(self.player.maxhp, self.player.hp + 35)
        self.banner = LEVELS[idx]["name"]
        self.banner_t = 2.6
        self.start_wave()

    def start_wave(self):
        groups = LEVELS[self.level_idx]["waves"][self.wave_idx]
        queue = []
        t = 0.0
        for kind, count, interval in groups:
            for _ in range(count):
                queue.append((t, kind))
                t += interval
        queue.sort(key=lambda it: it[0])
        self.spawn_queue = queue
        self.spawn_t = 0.0
        self.wave_clear_t = 0.0

    def next_wave(self):
        self.wave_idx += 1
        if self.wave_idx >= len(LEVELS[self.level_idx]["waves"]):
            self.level_clear()
        else:
            self.start_wave()
            self.banner = "DALGA %d" % (self.wave_idx + 1)
            self.banner_t = 1.8

    def level_clear(self):
        bonus = int(500 * (self.level_idx + 1) * self.diff["score"])
        self.score += bonus
        self.last_bonus = bonus
        self.enemies = []
        self.ebullets = []
        if self.level_idx >= len(LEVELS) - 1:
            self.pending_score = int(self.score)
            self.name_input = ""
            self.name_active = True
            self.enter_state("victory")
        else:
            self.enter_state("levelclear")

    def next_level(self):
        self.start_level(self.level_idx + 1)
        self.enter_state("play")

    def to_menu(self):
        if self.state in ("gameover", "victory") and self.pending_score is not None:
            self.store_score()
        self.enemies = []
        self.pbullets = []
        self.ebullets = []
        self.particles = []
        self.pickups = []
        self.enter_state("menu")

    def game_over(self):
        self.pending_score = int(self.score)
        self.name_input = ""
        self.name_active = True
        self.enemies = []
        self.pbullets = []
        self.ebullets = []
        self.enter_state("gameover")

    def pause_game(self):
        if self.state == "play":
            self.enter_state("pause")

    def resume_game(self):
        if self.state == "pause":
            self.enter_state("play")

    def toggle_pause(self):
        if self.state == "play":
            self.pause_game()
        elif self.state == "pause":
            self.resume_game()

    # ------------------------------------------------------------ girdi
    def on_key_press(self, e):
        try:
            key = e.keysym
            self.keys[key] = True
            if key == "Escape":
                if self.state in ("gameover", "victory"):
                    self.to_menu()
                elif self.state == "settings":
                    self.enter_state(self.settings_back)
                else:
                    self.toggle_pause()
                return
            if self.state == "gameover" or self.state == "victory":
                if key == "Return" or key == "KP_Enter":
                    if self.pending_score is not None:
                        self.store_score()
                    else:
                        self.to_menu()
                    return
                if self.name_active:
                    if key == "BackSpace":
                        self.name_input = self.name_input[:-1]
                    elif len(key) == 1 and key.isprintable() and len(self.name_input) < 12:
                        self.name_input += key
                return
            if self.state == "levelclear" and (key == "Return" or key == "KP_Enter"):
                self.next_level()
                return
            if self.state == "menu" and key in ("Return", "KP_Enter"):
                self.start_game()
        except Exception:
            traceback.print_exc()

    def on_key_release(self, e):
        try:
            self.keys[e.keysym] = False
        except Exception:
            traceback.print_exc()

    def on_button_press(self, e):
        try:
            self.mx = e.x
            self.my = e.y
            self.mouse_in = True
            if self.state == "play":
                self.fire_held = True
            else:
                for b in self.buttons:
                    if b.contains(e.x, e.y):
                        b.click(e.x, e.y)
                        self.hover_idx = -1
                        break
        except Exception:
            traceback.print_exc()

    def on_button_release(self, e):
        try:
            self.fire_held = False
        except Exception:
            traceback.print_exc()

    def on_motion(self, e):
        try:
            self.mx = e.x
            self.my = e.y
            self.mouse_in = True
            self.hover_idx = -1
            for i, b in enumerate(self.buttons):
                if b.contains(e.x, e.y):
                    self.hover_idx = i
                    break
        except Exception:
            traceback.print_exc()

    def on_leave(self, e):
        try:
            self.mouse_in = False
            self.hover_idx = -1
        except Exception:
            traceback.print_exc()

    # -------------------------------------------------------------- mantik
    def burst(self, x, y, n, color, spd=170, size=3, life=0.45):
        for _ in range(n):
            a = random.uniform(0, math.tau)
            v = random.uniform(spd * 0.35, spd)
            self.particles.append(Particle(x, y, math.cos(a) * v, math.sin(a) * v,
                                           random.uniform(life * 0.5, life),
                                           random.uniform(size * 0.6, size), color))

    def spawn_point(self):
        pad = 70
        side = random.randint(0, 3)
        if side == 0:
            return random.uniform(pad, W - pad), PLAY_TOP + 20
        if side == 1:
            return random.uniform(pad, W - pad), H - 40
        if side == 2:
            return pad, random.uniform(PLAY_TOP + 40, H - 40)
        return W - pad, random.uniform(PLAY_TOP + 40, H - 40)

    def spawn_enemy(self, kind):
        x, y = self.spawn_point()
        for _ in range(14):
            if dist2(x, y, self.player.x, self.player.y) > 220 * 220:
                break
            x, y = self.spawn_point()
        st = ENEMY_STATS[kind]
        d = self.diff
        e = Enemy(kind, x, y)
        e.hp = e.maxhp = st["hp"] * d["hp"] * (1.0 + 0.12 * self.level_idx)
        e.speed = st["speed"] * d["spd"] * (1.0 + 0.05 * self.level_idx)
        e.dmg = st["dmg"] * d["dmg"]
        self.enemies.append(e)

    def fire(self):
        p = self.player
        ang = p.aim
        n = 3 if self.powerups["spread"] > 0 else 1
        offs = [0.0] if n == 1 else [-0.16, 0.0, 0.16]
        for o in offs:
            a = ang + o
            b = Bullet(p.x + math.cos(a) * 20, p.y + math.sin(a) * 20,
                       math.cos(a) * 640, math.sin(a) * 640, 4.5, 11,
                       C_CYAN, True, mix(C_CYAN, "#ffffff", 0.35))
            self.pbullets.append(b)
        self.player.muzzle = 0.07
        p.vx -= math.cos(ang) * 46
        p.vy -= math.sin(ang) * 46
        self.burst(p.x + math.cos(ang) * 22, p.y + math.sin(ang) * 22, 3, C_CYAN, 120, 2, 0.2)

    def hurt_player(self, amount):
        if self.state != "play":
            return
        if self.player.invuln > 0:
            return
        if self.powerups["shield"] > 0:
            self.powerups["shield"] = 0.0
            self.player.invuln = 0.9
            self.burst(self.player.x, self.player.y, 16, C_CYAN, 200, 3, 0.5)
            self.shake = 5
            return
        self.player.hp -= amount
        self.player.invuln = 0.75
        self.combo = 1
        self.combo_t = 0.0
        self.shake = 9
        self.burst(self.player.x, self.player.y, 12, C_DANGER, 190, 3, 0.45)
        if self.player.hp <= 0:
            self.player.hp = 0
            self.game_over()

    def kill_enemy(self, e):
        e.dead = True
        self.combo_t = 2.6
        self.combo = min(5, self.combo + 1)
        gain = int(e.score * self.diff["score"] * self.combo)
        self.score += gain
        self.burst(e.x, e.y, 14, e.color, 220, 4, 0.55)
        self.burst(e.x, e.y, 6, shade(e.color, 1.4), 140, 3, 0.4)
        roll = random.random()
        if e.kind == "boss":
            self.burst(e.x, e.y, 60, e.color, 320, 6, 1.0)
            self.shake = 16
        elif roll < 0.12:
            self.pickups.append(Pickup(e.x, e.y, "health"))
        elif roll < 0.21:
            self.pickups.append(Pickup(e.x, e.y, "rapid"))
        elif roll < 0.30:
            self.pickups.append(Pickup(e.x, e.y, "spread"))
        elif roll < 0.40:
            self.pickups.append(Pickup(e.x, e.y, "gem"))

    def damage_enemy(self, e, dmg):
        e.hp -= dmg
        e.flash = 0.09
        if e.hp <= 0:
            self.kill_enemy(e)

    def update_enemy(self, e, dt):
        p = self.player
        dx = p.x - e.x
        dy = p.y - e.y
        d = math.sqrt(dx * dx + dy * dy) or 1.0
        nx = dx / d
        ny = dy / d
        e.aim = math.atan2(dy, dx)
        e.flash = max(0.0, e.flash - dt)
        e.bob += dt

        if e.kind == "imp":
            if e.state == "chase":
                e.ax = nx
                e.ay = ny
                e.dash_cd -= dt
                if e.dash_cd <= 0 and d < 320:
                    e.state = "windup"
                    e.timer = 0.38
            elif e.state == "windup":
                e.timer -= dt
                e.ax = nx * 0.25
                e.ay = ny * 0.25
                if e.timer <= 0:
                    e.state = "dash"
                    e.timer = 0.48
                    e.dash_x = nx
                    e.dash_y = ny
            elif e.state == "dash":
                e.timer -= dt
                e.ax = e.dash_x
                e.ay = e.dash_y
                if e.timer <= 0:
                    e.state = "recover"
                    e.timer = 0.5
            else:
                e.timer -= dt
                e.ax = -nx * 0.35
                e.ay = -ny * 0.35
                if e.timer <= 0:
                    e.state = "chase"
                    e.dash_cd = random.uniform(1.6, 2.8)
            sp = e.speed * (1.9 if e.state == "dash" else 1.0)
            if e.state == "windup":
                sp = e.speed * 0.25

        elif e.kind == "guard":
            want = 300.0
            e.strafe_cd -= dt
            if e.strafe_cd <= 0:
                e.strafe = -e.strafe
                e.strafe_cd = random.uniform(1.0, 2.2)
            if d > want + 70:
                e.ax = nx
                e.ay = ny
            elif d < want - 70:
                e.ax = -nx
                e.ay = -ny
            else:
                e.ax = -ny * e.strafe
                e.ay = nx * e.strafe
            # atisdan kacinma
            for b in self.pbullets:
                if not b.alive:
                    continue
                if dist2(b.x, b.y, e.x, e.y) < 78 * 78:
                    e.ax += -ny * e.strafe * 1.4
                    e.ay += nx * e.strafe * 1.4
                    break
            e.fire_cd -= dt
            if e.fire_cd <= 0 and d < 720:
                e.fire_cd = random.uniform(1.35, 2.1) / (1.0 + 0.12 * self.level_idx)
                n = 1 + (1 if self.level_idx >= 1 else 0) + (1 if self.level_idx >= 2 else 0)
                spread = 0.14
                for i in range(n):
                    a = e.aim + (i - (n - 1) / 2.0) * spread
                    self.ebullets.append(Bullet(e.x + math.cos(a) * 24, e.y + math.sin(a) * 24,
                                                math.cos(a) * 300, math.sin(a) * 300, 5, 9,
                                                C_DANGER, False, C_WARN))
            sp = e.speed

        elif e.kind == "drone":
            wob = math.sin(self.game_time * 3.1 + e.phase) * 0.75
            a = math.atan2(ny, nx) + wob
            e.ax = math.cos(a)
            e.ay = math.sin(a)
            sp = e.speed
            if d < e.r + p.r:
                self.hurt_player(e.dmg)
                self.kill_enemy(e)
                return

        else:  # boss
            e.fire_cd -= dt
            e.timer -= dt
            if e.state == "idle":
                e.ax = nx * 0.45
                e.ay = ny * 0.45
                if e.timer <= 0:
                    if d < 300 and random.random() < 0.45:
                        e.state = "charge"
                        e.timer = 0.7
                        e.charge_x = nx
                        e.charge_y = ny
                        e.fire_cd = 0.4
                    else:
                        e.state = random.choice(("volley", "radial", "summon"))
                        e.timer = 1.5
                        e.fire_cd = 0.2
            elif e.state == "volley":
                e.ax = nx * 0.25
                e.ay = ny * 0.25
                if e.fire_cd <= 0:
                    e.fire_cd = 0.16
                    for i in range(5):
                        a = e.aim + (i - 2) * 0.11
                        self.ebullets.append(Bullet(e.x + math.cos(a) * 50, e.y + math.sin(a) * 50,
                                                    math.cos(a) * 280, math.sin(a) * 280, 6, 11,
                                                    C_DANGER, False, C_WARN))
                if e.timer <= 0:
                    e.state = "idle"
                    e.timer = 1.6
            elif e.state == "radial":
                e.ax = -nx * 0.3
                e.ay = -ny * 0.3
                if e.fire_cd <= 0:
                    e.fire_cd = 0.1
                    base = random.uniform(0, math.tau)
                    for i in range(16):
                        a = base + i * math.tau / 16.0
                        self.ebullets.append(Bullet(e.x + math.cos(a) * 54, e.y + math.sin(a) * 54,
                                                    math.cos(a) * 210, math.sin(a) * 210, 6, 10,
                                                    C_DANGER, False, C_WARN))
                if e.timer <= 0:
                    e.state = "idle"
                    e.timer = 1.5
            elif e.state == "summon":
                e.ax = 0.0
                e.ay = 0.0
                if e.fire_cd <= 0:
                    e.fire_cd = 0.3
                    for _ in range(2):
                        a = random.uniform(0, math.tau)
                        sx = clamp(e.x + math.cos(a) * 70, 40, W - 40)
                        sy = clamp(e.y + math.sin(a) * 70, PLAY_TOP + 40, H - 40)
                        imp = Enemy("imp", sx, sy)
                        imp.hp = imp.maxhp = ENEMY_STATS["imp"]["hp"] * self.diff["hp"] * 0.8
                        imp.speed = ENEMY_STATS["imp"]["speed"] * self.diff["spd"] * 1.1
                        imp.dmg = ENEMY_STATS["imp"]["dmg"] * self.diff["dmg"]
                        self.enemies.append(imp)
                if e.timer <= 0:
                    e.state = "idle"
                    e.timer = 1.7
            elif e.state == "charge":
                e.ax = e.charge_x
                e.ay = e.charge_y
                if e.timer <= 0:
                    e.state = "idle"
                    e.timer = 1.2
                    e.fire_cd = 0.5
            sp = e.speed * (3.0 if e.state == "charge" else 1.0)

        # ivme ve hareket
        ax = e.ax
        ay = e.ay
        mag = math.hypot(ax, ay)
        if mag > 1.0:
            ax /= mag
            ay /= mag
        e.vx += ax * sp * 6.0 * dt
        e.vy += ay * sp * 6.0 * dt
        fr = 1.0 - min(0.9, 5.0 * dt)
        e.vx *= fr
        e.vy *= fr
        vmag = math.hypot(e.vx, e.vy)
        if vmag > sp:
            e.vx = e.vx / vmag * sp
            e.vy = e.vy / vmag * sp
        e.x += e.vx * dt
        e.y += e.vy * dt
        e.x = clamp(e.x, 30, W - 30)
        e.y = clamp(e.y, PLAY_TOP + e.r, H - e.r - 6)

    def update_play(self, dt):
        p = self.player
        self.game_time += dt
        self.banner_t = max(0.0, self.banner_t - dt)
        self.contact_cd = max(0.0, self.contact_cd - dt)
        p.invuln = max(0.0, p.invuln - dt)
        p.muzzle = max(0.0, p.muzzle - dt)
        for k in self.powerups:
            self.powerups[k] = max(0.0, self.powerups[k] - dt)

        # combo zamanlayici
        if self.combo > 1:
            self.combo_t -= dt
            if self.combo_t <= 0:
                self.combo = 1

        # oyuncu hareketi
        ax = 0.0
        ay = 0.0
        if self.keys.get("w") or self.keys.get("Up"):
            ay -= 1.0
        if self.keys.get("s") or self.keys.get("Down"):
            ay += 1.0
        if self.keys.get("a") or self.keys.get("Left"):
            ax -= 1.0
        if self.keys.get("d") or self.keys.get("Right"):
            ax += 1.0
        if ax and ay:
            m = math.hypot(ax, ay)
            ax /= m
            ay /= m
        p.vx += ax * 1900 * dt
        p.vy += ay * 1900 * dt
        fr = 1.0 - min(0.9, 6.5 * dt)
        p.vx *= fr
        p.vy *= fr
        vmag = math.hypot(p.vx, p.vy)
        maxv = 300.0
        if vmag > maxv:
            p.vx = p.vx / vmag * maxv
            p.vy = p.vy / vmag * maxv
        p.x = clamp(p.x + p.vx * dt, 26, W - 26)
        p.y = clamp(p.y + p.vy * dt, PLAY_TOP + 34, H - 26)

        # nişan
        aim_x = self.mx
        aim_y = self.my
        if self.settings["autoaim"]:
            best = None
            bd = 620 * 620
            for e in self.enemies:
                if e.dead:
                    continue
                d2 = dist2(e.x, e.y, p.x, p.y)
                if d2 < bd:
                    bd = d2
                    best = e
            if best is not None:
                aim_x = best.x
                aim_y = best.y
        p.aim = math.atan2(aim_y - p.y, aim_x - p.x)
        p.bob += dt

        # ates
        self.fire_cd -= dt
        if (self.fire_held or self.keys.get("space")) and self.fire_cd <= 0:
            self.fire()
            base = 0.20
            if self.powerups["rapid"] > 0:
                base *= 0.55
            self.fire_cd = base

        # dalga dogumu
        self.spawn_t += dt
        while self.spawn_queue and self.spawn_queue[0][0] <= self.spawn_t:
            kind = self.spawn_queue.pop(0)[1]
            self.spawn_enemy(kind)

        # dusmanlar
        for e in list(self.enemies):
            if e.dead:
                continue
            self.update_enemy(e, dt)

        # dusmanlarin birbirine itmesi
        for i in range(len(self.enemies)):
            a = self.enemies[i]
            if a.dead:
                continue
            for j in range(i + 1, len(self.enemies)):
                b = self.enemies[j]
                if b.dead:
                    continue
                d2 = dist2(a.x, a.y, b.x, b.y)
                rr = (a.r + b.r) * 0.95
                if d2 < rr * rr and d2 > 0.01:
                    d = math.sqrt(d2)
                    push = (rr - d) * 0.5
                    ux = (b.x - a.x) / d
                    uy = (b.y - a.y) / d
                    a.x -= ux * push
                    a.y -= uy * push
                    b.x += ux * push
                    b.y += uy * push

        # oyuncu mermileri
        for b in self.pbullets:
            b.x += b.vx * dt
            b.y += b.vy * dt
            b.life -= dt
            if b.life <= 0 or b.x < -20 or b.x > W + 20 or b.y < PLAY_TOP - 20 or b.y > H + 20:
                b.alive = False
                continue
            for e in self.enemies:
                if e.dead:
                    continue
                rr = b.r + e.r
                if dist2(b.x, b.y, e.x, e.y) < rr * rr:
                    self.damage_enemy(e, b.dmg)
                    self.burst(b.x, b.y, 4, C_CYAN, 120, 2, 0.22)
                    if b.pierce > 0:
                        b.pierce -= 1
                    else:
                        b.alive = False
                    break
        self.pbullets = [b for b in self.pbullets if b.alive]

        # dusman mermileri
        for b in self.ebullets:
            b.x += b.vx * dt
            b.y += b.vy * dt
            b.life -= dt
            if b.life <= 0 or b.x < -20 or b.x > W + 20 or b.y < PLAY_TOP - 20 or b.y > H + 20:
                b.alive = False
                continue
            rr = b.r + p.r
            if dist2(b.x, b.y, p.x, p.y) < rr * rr:
                b.alive = False
                self.hurt_player(b.dmg)
        self.ebullets = [b for b in self.ebullets if b.alive]

        # temas hasari
        if self.contact_cd <= 0:
            for e in self.enemies:
                if e.dead or e.kind == "drone":
                    continue
                rr = e.r + p.r * 0.85
                if dist2(e.x, e.y, p.x, p.y) < rr * rr:
                    self.hurt_player(e.dmg)
                    self.contact_cd = 0.7
                    self.burst(e.x, e.y, 6, e.color, 160, 3, 0.3)
                    break

        # toplama nesneleri
        for it in list(self.pickups):
            it.t += dt
            it.vy = min(70.0, it.vy + 120 * dt)
            it.y += it.vy * dt
            if dist2(it.x, it.y, p.x, p.y) < (p.r + 16) ** 2:
                self.pickups.remove(it)
                self.apply_pickup(it.kind)
            elif it.y > H - 10:
                self.pickups.remove(it)

        # parcaciklar
        for q in self.particles:
            q.x += q.vx * dt
            q.y += q.vy * dt
            q.vx *= 1.0 - min(0.9, q.drag * dt)
            q.vy *= 1.0 - min(0.9, q.drag * dt)
            q.life -= dt
        self.particles = [q for q in self.particles if q.life > 0]

        # ekran sarsintisi
        if self.settings["shake"] and self.shake > 0:
            self.shake = max(0.0, self.shake - dt * 26)
            self.ox = random.uniform(-self.shake, self.shake)
            self.oy = random.uniform(-self.shake, self.shake)
        else:
            self.ox = 0.0
            self.oy = 0.0

        # dalga / seviye akisi
        alive = len([e for e in self.enemies if not e.dead])
        if not self.spawn_queue and alive == 0:
            self.wave_clear_t += dt
            if self.wave_clear_t > 1.0:
                self.next_wave()
        else:
            self.wave_clear_t = 0.0

    def apply_pickup(self, kind):
        p = self.player
        if kind == "health":
            p.hp = min(p.maxhp, p.hp + 25)
            self.burst(p.x, p.y, 12, C_OK, 170, 3, 0.4)
        elif kind == "rapid":
            self.powerups["rapid"] = 8.0
            self.burst(p.x, p.y, 12, C_WARN, 170, 3, 0.4)
        elif kind == "spread":
            self.powerups["spread"] = 9.0
            self.burst(p.x, p.y, 12, C_CYAN, 170, 3, 0.4)
        elif kind == "gem":
            self.score += int(150 * self.diff["score"] * self.combo)
            self.burst(p.x, p.y, 10, C_GOLD, 170, 3, 0.35)

    # ---------------------------------------------------------------- cizim
    def draw_background(self, c, t):
        c.create_rectangle(0, 0, W, H, fill=C_BG, outline="")
        c.create_rectangle(0, 0, W, PLAY_TOP, fill=C_BG2, outline="")
        for s in self.stars:
            x = (s[0] - t * 14 * s[3]) % W
            y = (s[1] - t * 26 * s[3]) % (H - PLAY_TOP) + PLAY_TOP
            c.create_rectangle(x, y, x + s[2], y + s[2],
                               fill=mix(C_BG, C_DIM, 0.25 + 0.35 * s[3]), outline="")
        # dekoratif gezegenler
