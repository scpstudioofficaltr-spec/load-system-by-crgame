# ---------------------------------------------------------------- arayuz parca
class Btn(object):
    def __init__(self, x, y, w, h, label, action, kind="primary", size=17, sub=""):
        self.x = x
        self.y = y
        self.w = w
        self.h = h
        self.label = label
        self._action = action
        self.kind = kind
        self.size = size
        self.sub = sub

    def contains(self, x, y):
        return self.x <= x <= self.x + self.w and self.y <= y <= self.y + self.h

    def click(self, x, y):
        if self.contains(x, y):
            if self._action:
                self._action()

    def draw(self, c, hover=False):
        off = -2 if hover else 0
        x1 = self.x
        y1 = self.y + off
        x2 = self.x + self.w
        y2 = self.y + self.h + off
        base = {"primary": C_ACCENT, "danger": C_DANGER, "ghost": C_PANEL_HI,
                "gold": C_GOLD, "ok": C_OK}.get(self.kind, C_ACCENT)
        ink = C_INK if self.kind in ("primary", "danger", "gold", "ok") else C_TEXT
        if hover:
            base = shade(base, 1.16)
        soft_shadow(c, x1, y1, x2, y2, 14, 3)
        c.create_polygon(rounded_points(x1, y1, x2, y2, 14), smooth=True, fill=base, outline="")
        c.create_polygon(rounded_points(x1 + 10, y1 + 3, x2 - 10, y1 + 6, 2),
                         smooth=True, fill=shade(base, 1.28), outline="")
        ty = (y1 + y2) / 2.0 - (7 if self.sub else 0)
        txt(c, (x1 + x2) / 2.0, ty, self.label, self.size, ink)
        if self.sub:
            txt(c, (x1 + x2) / 2.0, (y1 + y2) / 2.0 + 13, self.sub, 10, mix(ink, C_BG, 0.4))


class SettingRow(object):
    def __init__(self, x, y, w, h, label, options, index, on_change):
        self.x = x
        self.y = y
        self.w = w
        self.h = h
        self.label = label
        self.options = options
        self.index = index
        self.on_change = on_change

    def contains(self, x, y):
        return self.x <= x <= self.x + self.w and self.y <= y <= self.y + self.h

    def click(self, x, y):
        if not self.contains(x, y):
            return
        left_x = self.x + self.w - 104
        right_x = self.x + self.w - 44
        if left_x <= x <= left_x + 34:
            self.index = (self.index - 1) % len(self.options)
        elif right_x <= x <= right_x + 34:
            self.index = (self.index + 1) % len(self.options)
        else:
            self.index = (self.index + 1) % len(self.options)
        if self.on_change:
            self.on_change(self.index)

    def draw(self, c, hover=False):
        x1 = self.x
        y1 = self.y
        x2 = self.x + self.w
        y2 = self.y + self.h
        panel(c, x1, y1, x2, y2, 12, C_PANEL if not hover else C_PANEL_HI, shadow=2)
        txt(c, x1 + 22, (y1 + y2) / 2.0, self.label, 15, C_TEXT, anchor="w")
        txt(c, x2 - 152, (y1 + y2) / 2.0, self.options[self.index], 15, C_CYAN)
        lx = x2 - 96
        rx = x2 - 36
        for cx, sym in ((lx, "<"), (rx, ">")):
            c.create_polygon(rounded_points(cx - 16, (y1 + y2) / 2.0 - 14, cx + 16,
                                           (y1 + y2) / 2.0 + 14, 8),
                             smooth=True, fill=C_PANEL_HI, outline="")
            txt(c, cx, (y1 + y2) / 2.0, sym, 14, C_TEXT)


class NameField(object):
    def __init__(self, x, y, w, h, on_click):
        self.x = x
        self.y = y
        self.w = w
        self.h = h
        self.on_click = on_click

    def contains(self, x, y):
        return self.x <= x <= self.x + self.w and self.y <= y <= self.y + self.h

    def click(self, x, y):
        if self.contains(x, y) and self.on_click:
            self.on_click()

    def draw(self, c, hover=False):
        pass


