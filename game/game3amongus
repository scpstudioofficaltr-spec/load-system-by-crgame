        self.running = True
        self.state = "menu"
        self.settings = {"diff": 1, "fps": True, "shake": True, "autoaim": False}
        self.settings_back = "menu"
        self._root_prev = ""
        self.buttons = []
        self.hover_idx = -1
        self.keys = {}
        self.mx = W / 2.0
        self.my = H / 2.0
        self.mouse_in = False
        self.fire_held = False
        self.scores = self.load_scores()
        self.name_input = ""
        self.pending_score = None
        self.name_active = False
        self.stars = []
        for _ in range(90):
            self.stars.append((random.uniform(0, W), random.uniform(PLAY_TOP, H),
                               random.choice((1, 1, 2, 2, 3)),
                               random.uniform(0.25, 1.0)))
        self.ox = 0.0
        self.oy = 0.0
        self.shake = 0.0
        self.time_acc = 0.0
        self.last_t = time.time()
        self.fps_t = self.last_t
        self.frames = 0
        self.fps = 0.0
        self.after_id = None
        self.build_window()
        self.enter_state("menu")

    # ------------------------------------------------------------- pencere
    def build_window(self):
        self.win = tk.Toplevel(self.root)
        self.win.title("Among Us 2D")
        self.win.configure(bg=C_BG)
        self.win.resizable(False, False)
        self.canvas = tk.Canvas(self.win, width=W, height=H, bg=C_BG,
                                highlightthickness=0, bd=0)
        self.canvas.pack()
        self.win.protocol("WM_DELETE_WINDOW", self.quit_app)
        self.install_root_protocol()
        binds = (("<KeyPress>", self.on_key_press),
                 ("<KeyRelease>", self.on_key_release),
                 ("<Button-1>", self.on_button_press),
                 ("<ButtonRelease-1>", self.on_button_release),
                 ("<Motion>", self.on_motion),
                 ("<Leave>", self.on_leave))
        for seq, fn in binds:
            self.win.bind(seq, fn)
        self.canvas.bind("<Configure>", lambda e: None)
        try:
            self.win.focus_force()
            self.canvas.focus_set()
        except Exception:
            traceback.print_exc()

    def install_root_protocol(self):
        """Ana pencerenin kapanis akisini temiz sekilde baglar."""
        prev = ""
        try:
            prev = self.root.protocol("WM_DELETE_WINDOW")
        except Exception:
            traceback.print_exc()
        self._root_prev = prev if prev and prev not in ("", "None") else ""
        self._root_ours = ""

        def _close():
            self.on_root_close()

        try:
            self.root.protocol("WM_DELETE_WINDOW", _close)
            self._root_ours = self.root.protocol("WM_DELETE_WINDOW") or ""
        except Exception:
            traceback.print_exc()

    def quit_app(self):
        self.running = False
        try:
            if self.win is not None and self.win.winfo_exists():
                self.win.destroy()
        except Exception:
            traceback.print_exc()
        self.call_prev_root_handler()
        try:
            if self.root.winfo_exists():
                self.root.destroy()
        except Exception:
            traceback.print_exc()

    def call_prev_root_handler(self):
        prev = getattr(self, "_root_prev", "")
        try:
            cur = self.root.protocol("WM_DELETE_WINDOW")
        except Exception:
            cur = ""
        if cur and cur != getattr(self, "_root_ours", "") and cur != prev:
            prev = cur
        if prev:
            try:
                self.root.tk.call(prev)
                self._root_prev = ""
            except Exception:
                traceback.print_exc()

    def on_root_close(self):
        self.quit_app()

    # ---------------------------------------------------------- skor tablosu
    def load_scores(self):
        out = []
        try:
            with open(SCORE_FILE, "r", encoding="utf-8") as fh:
                for line in fh:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        sc, nm = line.split("|", 1)
                        out.append((int(sc), nm.strip()[:12] or "PILOT"))
                    except Exception:
                        continue
        except Exception:
            pass
        out.sort(key=lambda t: -t[0])
        return out[:10]

    def save_scores(self):
        try:
            with open(SCORE_FILE, "w", encoding="utf-8") as fh:
                for sc, nm in self.scores[:10]:
                    fh.write("%d|%s\n" % (sc, nm))
        except Exception:
            traceback.print_exc()

    def store_score(self):
        if self.pending_score is None:
            return
        name = (self.name_input or "").strip()[:12] or "PILOT"
        self.scores.append((int(self.pending_score), name))
        self.scores.sort(key=lambda t: -t[0])
        self.scores = self.scores[:10]
        self.save_scores()
        self.pending_score = None
        self.name_active = False

    # -------------------------------------------------------------- durumlar
    def enter_state(self, st):
        self.state = st
        self.hover_idx = -1
        self.buttons = []
        if st == "menu":
            self.build_menu_buttons()
        elif st == "settings":
            self.build_settings_buttons()
        elif st == "play":
            self.build_play_buttons()
        elif st == "pause":
            self.build_pause_buttons()
        elif st == "levelclear":
            self.build_levelclear_buttons()
        elif st in ("gameover", "victory"):
            self.build_gameover_buttons()
        elif st == "settings":
            pass

