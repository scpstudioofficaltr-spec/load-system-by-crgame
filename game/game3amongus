    def draw_actor(self, c, x, y, r, color, dark, aim=0.0, bob=0.0, flash=0.0,
                   armed=None, scale=1.0):
        body_w = r * 1.7 * scale
        body_h = r * 2.0 * scale
        x1 = x - body_w / 2.0
        x2 = x + body_w / 2.0
        y1 = y - body_h / 2.0 + bob
        y2 = y + body_h / 2.0 + bob
        col = mix(color, "#ffffff", 0.72) if flash > 0 else color
        c.create_oval(x - body_w * 0.62, y2 - body_h * 0.16, x + body_w * 0.62,
                      y2 + body_h * 0.12, fill=C_SHADOW, outline="")
        # sirt cantasi
        c.create_polygon(rounded_points(x1 - body_w * 0.26, y1 + body_h * 0.18,
                                        x1 + body_w * 0.10, y2 - body_h * 0.18, r * 0.22),
                         smooth=True, fill=dark, outline="")
        # govde
        c.create_polygon(rounded_points(x1, y1, x2, y2, r * 0.55), smooth=True, fill=col, outline="")
        # alt golge
        c.create_polygon(rounded_points(x1, y1 + body_h * 0.46, x2, y2, r * 0.5),
                         smooth=True, fill=dark, outline="")
        # parlama
        c.create_polygon(rounded_points(x1 + body_w * 0.12, y1 + body_h * 0.08,
                                        x1 + body_w * 0.44, y1 + body_h * 0.30, r * 0.15),
                         smooth=True, fill=shade(col, 1.28), outline="")
        # visor
        vx = x + math.cos(aim) * r * 0.16
        vy = y - body_h * 0.20 + math.sin(aim) * r * 0.06
        vw = body_w * 0.76
        vh = body_h * 0.36
        c.create_polygon(rounded_points(vx - vw / 2.0, vy - vh / 2.0, vx + vw / 2.0, vy + vh / 2.0, r * 0.34),
                         smooth=True, fill="#8fc4f2", outline="")
        c.create_polygon(rounded_points(vx - vw / 2.0 + 2, vy - vh / 2.0 + 2,
                                        vx + vw / 2.0 - 2, vy + vh / 2.0 - 2, r * 0.3),
                         smooth=True, fill=C_VISOR, outline="")
        # ayaklar
        fw = body_w * 0.24
        c.create_polygon(rounded_points(x1 + body_w * 0.08, y2 - body_h * 0.04,
                                        x1 + body_w * 0.08 + fw, y2 + body_h * 0.12, r * 0.12),
                         smooth=True, fill=dark, outline="")
        c.create_polygon(rounded_points(x2 - body_w * 0.08 - fw, y2 - body_h * 0.04,
                                        x2 - body_w * 0.08, y2 + body_h * 0.12, r * 0.12),
                         smooth=True, fill=dark, outline="")
        if armed == "knife":
            ca = math.cos(aim)
            sa = math.sin(aim)
            bx = x + ca * r * 0.95
            by = y + sa * r * 0.95
            c.create_line(x + ca * r * 0.45, y + sa * r * 0.45, bx, by,
                          fill="#d9e0ef", width=max(3, r * 0.16))
            c.create_polygon(bx, by,
                             bx + ca * r * 0.55 - sa * r * 0.13,
                             by + sa * r * 0.55 + ca * r * 0.13,
                             bx + ca * r * 0.55 + sa * r * 0.13,
                             by + sa * r * 0.55 - ca * r * 0.13,
                             fill="#f4f8ff", outline="")
        elif armed == "gun":
            ca = math.cos(aim)
            sa = math.sin(aim)
            bx = x + ca * r * 1.2
            by = y + sa * r * 1.2
            c.create_line(x + ca * r * 0.4, y + sa * r * 0.4, bx, by,
                          fill="#c3cee4", width=max(4, r * 0.2))
            c.create_oval(bx - r * 0.15, by - r * 0.15, bx + r * 0.15, by + r * 0.15,
                          fill=C_CYAN, outline="")

