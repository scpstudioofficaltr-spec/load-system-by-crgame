        for b in self.ebullets:
            self.draw_bullet(c, b, ox, oy)
        p = self.player
        blink = p.invuln > 0 and int(p.invuln * 18) % 2 == 0
        if not blink:
            self.draw_actor(c, p.x + ox, p.y + oy, p.r, P_COLOR, P_DARK, p.aim,
                            math.sin(p.bob * 9.0) * 1.8, 0.0, "gun", 1.0)
