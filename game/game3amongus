    def draw_play(self, c, t):
        self.draw_background(c, t)
        ox = self.ox
        oy = self.oy
        for it in self.pickups:
            self.draw_pickup(c, it, ox, oy)
        for e in self.enemies:
            if e.dead:
                continue
            x = e.x + ox
            y = e.y + oy
            if e.kind == "drone":
                self.draw_drone(c, x, y, e.r, e.aim, e.flash)
            else:
                armed = "knife" if e.kind in ("imp", "boss") else "gun"
                sc = 1.0
                if e.kind == "boss":
                    sc = 1.0
                self.draw_actor(c, x, y, e.r, e.color, e.dark, e.aim,
                                math.sin(e.bob * 6.0) * 1.6, e.flash, armed, sc)
                if e.kind == "imp" and e.state == "windup":
                    rr = e.r * (2.2 - e.timer)
                    c.create_oval(x - rr, y - rr, x + rr, y + rr,
                                  outline=C_DANGER, width=2)
                if e.kind == "guard":
                    c.create_oval(x - e.r * 1.5, y - e.r * 1.5, x + e.r * 1.5, y + e.r * 1.5,
                                  outline=mix(C_BG, C_WARN, 0.45), width=1)
        for q in self.particles:
            a = clamp(q.life / q.max, 0, 1)
            s = q.size * (0.4 + a * 0.8)
            x = q.x + ox
            y = q.y + oy
            c.create_oval(x - s, y - s, x + s, y + s,
                          fill=mix(C_BG, q.color, 0.35 + 0.65 * a), outline="")
