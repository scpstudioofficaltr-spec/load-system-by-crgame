import math
import random
import time
import tkinter as tk

TITLE = "SAN NOVA 2D"
TS = 40                     # karo boyu (piksel)
BLK = 10                    # blok boyu (karo)
NB = 9                      # blok sayısı (NB x NB)
MW = MH = NB * BLK          # harita boyutu (karo)
ROAD, SIDE, BLDG, PARK = 0, 1, 2, 3
MAX_WANTED = 5

C_ROAD = "#2b2f38"
C_ROAD_ALT = "#2f3440"
C_LANE = "#f2c94c"
C_WALK = "#bdb8aa"
C_WALK_JOINT = "#a59f90"
C_GRASS = "#3f7d4a"
C_GRASS_ALT = "#397247"
C_PATH = "#d6c6a0"
C_TREE = "#2a5e36"
C_TREE_HI = "#5aa86a"
C_SHADOW = "#1b1e25"
C_SHADOW_SOFT = "#23262e"
C_BLD_SHADOW = "#1c1f25"
C_HUD = "#0b0e14"
C_HUD_EDGE = "#2c3240"
C_YELLOW = "#ffd60a"
C_POLICE = "#1e3a8a"
C_TEXT = "#eef1f7"
C_MUTED = "#9aa3b5"

BLDG_PAL = [("#6f7d8c", "#8a99a8"), ("#b98b6b", "#d1a685"), ("#7c9a86", "#9bb8a4"),
            ("#a7a06a", "#c4bf86"), ("#8e7aa6", "#a998c2"), ("#5d6f8f", "#7889ab")]
CAR_PAL = ["#e63946", "#1d70e0", "#f1f1f1", "#2b2b2b", "#f4a261", "#2a9d8f", "#9b5de5", "#ffd166"]
SHIRT_PAL = ["#ffd166", "#06d6a0", "#ef476f", "#118ab2", "#f8f9fa", "#adb5bd", "#8338ec"]
SKIN_PAL = ["#f1c27d", "#c68642", "#8d5524", "#ffdbac"]


# ---------- Renk ve geometri yardımcıları ----------
def clamp(v, lo, hi):
    return lo if v < lo else hi if v > hi else v


def rgb(h):
    return int(h[1:3], 16), int(h[3:5], 16), int(h[5:7], 16)


def mixc(a, b, t):
    t = clamp(t, 0.0, 1.0)
    ra, ga, ba = rgb(a)
    rb, gb, bb = rgb(b)
    return "#%02x%02x%02x" % (int(ra + (rb - ra) * t), int(ga + (gb - ga) * t),
                              int(ba + (bb - ba) * t))


def shade(c, f):
    """f < 1: koyulaştır, f > 1: açıklaştır."""
    if f < 1:
        return mixc(c, "#000000", 1 - f)
    return mixc(c, "#ffffff", f - 1)


def angdiff(a, b):
    return (b - a + math.pi) % (2 * math.pi) - math.pi


def rot_rect(cx, cy, a, L, W):
    c, s = math.cos(a), math.sin(a)
    out = []
    for lx, ly in ((L, W), (L, -W), (-L, -W), (-L, W)):
        out.append(cx + lx * c - ly * s)
        out.append(cy + lx * s + ly * c)
    return out


def local_pt(cx, cy, a, lx, ly):
    c, s = math.cos(a), math.sin(a)
    return cx + lx * c - ly * s, cy + lx * s + ly * c


# ---------- Harita ----------
def gen_city(rnd):
    tiles = [[ROAD] * MW for _ in range(MH)]
    blocks = {}
    for by in range(NB):
        for bx in range(NB):
            kind = BLDG if rnd.random() < 0.72 else PARK
            wall, roof = rnd.choice(BLDG_PAL)
            blocks[(bx, by)] = {"kind": kind, "wall": wall, "roof": roof,
                                "seed": rnd.randrange(1000)}
            for ly in range(BLK):
                for lx in range(BLK):
                    tx, ty = bx * BLK + lx, by * BLK + ly
                    if lx < 2 or ly < 2:
                        t = ROAD
                    elif lx in (2, 9) or ly in (2, 9):
                        t = SIDE
                    else:
                        t = kind
                    tiles[ty][tx] = t
    return tiles, blocks


def build_minimap(master, tiles, blocks):
    rows = []
    for ty in range(MH):
        row = []
        for tx in range(MW):
            t = tiles[ty][tx]
            if t == ROAD:
                c = C_ROAD
            elif t == SIDE:
                c = C_WALK
            elif t == PARK:
                c = C_GRASS
            else:
                c = blocks[(tx // BLK, ty // BLK)]["wall"]
            row.append(c)
        rows.append("{" + " ".join(row) + "}")
    img = tk.PhotoImage(master=master, width=MW, height=MH)
    img.put(" ".join(rows), to=(0, 0))
    return img.zoom(2, 2)


# ---------- Oyun ----------
class Game:
    def __init__(self, parent):
        self.win = tk.Toplevel(parent)
        self.win.title(TITLE)
        self.win.configure(bg=C_HUD)
        try:
            self.win.state("zoomed")
        except tk.TclError:
            self.win.geometry("1200x750")
        self.cv = tk.Canvas(self.win, bg=C_ROAD, highlightthickness=0)
        self.cv.pack(fill="both", expand=True)

        self.rnd = random.Random(2025)
        self.tiles, self.blocks = gen_city(self.rnd)
        self.mini = build_minimap(self.win, self.tiles, self.blocks)

        self.keys = set()
        self.mx, self.my = 400, 300
        self.firing = False
        self.dead = False
        self.t = 0.0
        self.fps = 60.0
        self.last = time.perf_counter()
        self.w, self.h = 1000, 700
        self.cam_x = self.cam_y = 0.0

        self.px, self.py = self.free_point(road=True)
        self.cam_x = self.px - self.w / 2
        self.cam_y = self.py - self.h / 2
        self.pa = 0.0
        self.walking = False
        self.walk_t = 0.0
        self.hp = 100.0
        self.cash = 500
        self.wanted = 0
        self.heat = 0.0
        self.cool = 0.0
        self.shot_t = -10.0
        self.police_t = 0.0
        self.skid_t = 0.0
        self.down_t = 0.0
        self.car = None
        self.msg = "San Nova'ya hoş geldin"
        self.msg_t = 4.0
        self.bullets = []
        self.parts = []
        self.skids = []

        self.cars = [self.new_traffic() for _ in range(38)]
        self.cars += [self.new_parked() for _ in range(18)]
        self.peds = [self.new_ped() for _ in range(60)]
        self.coins = [self.new_coin() for _ in range(30)]
        self.mission = None
        self.mission_reward = 0
        self.new_mission()

        self.cv.bind("<Motion>", self.on_motion)
        self.cv.bind("<ButtonPress-1>", lambda e: setattr(self, "firing", True))
        self.cv.bind("<ButtonRelease-1>", lambda e: setattr(self, "firing", False))
        w = self.win
        w.bind("<KeyPress>", self.on_down)
        w.bind("<KeyRelease>", self.on_up)
        w.protocol("WM_DELETE_WINDOW", self.close)
        w.focus_force()
        self.loop()

    # ----- yardımcılar -----
    def say(self, text, t=3.0):
        self.msg = text
        self.msg_t = t

    def free_point(self, road=False):
        while True:
            tx = self.rnd.randrange(MW)
            ty = self.rnd.randrange(MH)
            t = self.tiles[ty][tx]
            if t in (BLDG, PARK) or (road and t != ROAD):
                continue
            return (tx + 0.5) * TS, (ty + 0.5) * TS

    def solid(self, x, y):
        tx, ty = int(x // TS), int(y // TS)
        if tx < 0 or ty < 0 or tx >= MW or ty >= MH:
            return True
        return self.tiles[ty][tx] == BLDG

    def blocked(self, x, y, r):
        return (self.solid(x - r, y - r) or self.solid(x + r, y - r) or
                self.solid(x - r, y + r) or self.solid(x + r, y + r))

    def move(self, x, y, dx, dy, r):
        if not self.blocked(x + dx, y, r):
            x += dx
        if not self.blocked(x, y + dy, r):
            y += dy
        return x, y

    def drive(self, c, dt, r=12):
        nx = c["x"] + math.cos(c["a"]) * c["v"] * dt
        ny = c["y"] + math.sin(c["a"]) * c["v"] * dt
        if self.blocked(nx, ny, r):
            c["v"] *= -0.2
            return False
        c["x"], c["y"] = nx, ny
        return True

    def explode(self, x, y, n, cols=("#ff7b00", "#ffd166", "#ff3d3d", "#6b6f78")):
        for _ in range(n):
            a = self.rnd.uniform(0, math.tau)
            s = self.rnd.uniform(60, 240)
            self.parts.append({"x": x, "y": y, "dx": math.cos(a) * s, "dy": math.sin(a) * s,
                               "life": self.rnd.uniform(0.3, 0.8),
                               "col": self.rnd.choice(cols), "r": self.rnd.uniform(2, 4)})

    # ----- oluşturma -----
    def new_traffic(self):
        r = self.rnd
        if r.random() < 0.5:
            base = r.randrange(0, NB) * BLK
            lane = r.choice((0.5, 1.5))
            y = (base + lane) * TS
            x = r.uniform(0, MW * TS)
            a = 0.0 if lane == 0.5 else math.pi
        else:
            base = r.randrange(0, NB) * BLK
            lane = r.choice((0.5, 1.5))
            x = (base + lane) * TS
            y = r.uniform(0, MH * TS)
            a = math.pi / 2 if lane == 0.5 else -math.pi / 2
        return {"kind": "traffic", "x": x, "y": y, "a": a, "v": r.uniform(90, 150),
                "col": r.choice(CAR_PAL), "hp": 3.0, "brake": False}

    def new_parked(self):
        c = self.new_traffic()
        c["kind"] = "parked"
        c["v"] = 0.0
        c["hp"] = 2.0
        return c

    def new_ped(self):
        x, y = self.free_point()
        return {"x": x, "y": y, "a": self.rnd.uniform(0, math.tau),
                "t": self.rnd.uniform(1, 3), "shirt": self.rnd.choice(SHIRT_PAL),
                "skin": self.rnd.choice(SKIN_PAL), "sp": self.rnd.uniform(30, 55),
                "ph": self.rnd.uniform(0, 6), "dead": False}

    def new_coin(self):
        x, y = self.free_point(road=True)
        return {"x": x, "y": y, "ph": self.rnd.uniform(0, 6)}

    def new_mission(self):
        self.mission = self.free_point()
        self.mission_reward = self.rnd.randrange(300, 1250, 50)

    # ----- girdi -----
    def on_down(self, e):
        k = e.keysym.lower()
        if k == "escape":
            self.close()
            return
        if k not in self.keys and k == "e" and self.down_t <= 0:
            self.toggle_car()
        self.keys.add(k)

    def on_up(self, e):
        self.keys.discard(e.keysym.lower())

    def on_motion(self, e):
        self.mx, self.my = e.x, e.y

    def close(self):
        self.dead = True
        try:
            self.win.destroy()
        except tk.TclError:
            pass

    # ----- araç -----
    def toggle_car(self):
        if self.car is not None:
            c = self.car
            self.leave_car()
            nx, ny = local_pt(c["x"], c["y"], c["a"], 0, 30)
            if not self.blocked(nx, ny, 8):
                self.px, self.py = nx, ny
            self.say("Araçtan indin")
            return
        best, bd = None, 46
        for c in self.cars:
            if c["kind"] != "parked" or abs(c["v"]) > 15:
                continue
            d = math.hypot(c["x"] - self.px, c["y"] - self.py)
            if d < bd:
                best, bd = c, d
        if best is not None:
            self.cars.remove(best)
            best["kind"] = "mine"
            best["hp"] = max(best["hp"], 6.0)
            self.car = best
            self.say("Araca bindin  |  W/S gaz-fren, A/D yön")

    def leave_car(self):
        if self.car is not None:
            c = self.car
            c["kind"] = "parked"
            c["v"] = 0.0
            c["brake"] = False
            self.cars.append(c)
            self.car = None

    # ----- güncelleme -----
    def update(self, dt):
        self.t += dt
        if self.msg_t > 0:
            self.msg_t -= dt
        target_x = self.px - self.w / 2
        target_y = self.py - self.h / 2
        k = min(1.0, dt * 9)
        self.cam_x += (target_x - self.cam_x) * k
        self.cam_y += (target_y - self.cam_y) * k
        if self.down_t > 0:
            self.down_t -= dt
            if self.down_t <= 0:
                self.respawn()
            self.update_world(dt)
            self.update_fx(dt)
            return
        self.update_player(dt)
        self.update_world(dt)
        self.update_fx(dt)

    def update_player(self, dt):
        k = self.keys
        sprint = "shift_l" in k or "shift_r" in k
        if self.car is None:
            dx = (1 if "d" in k else 0) - (1 if "a" in k else 0)
            dy = (1 if "s" in k else 0) - (1 if "w" in k else 0)
            self.pa = math.atan2(self.my + self.cam_y - self.py, self.mx + self.cam_x - self.px)
            self.walking = bool(dx or dy)
            if dx or dy:
                n = math.hypot(dx, dy)
                sp = 150 * (1.9 if sprint else 1.0) * dt
                self.px, self.py = self.move(self.px, self.py, dx / n * sp, dy / n * sp, 8)
                self.walk_t += dt * (1.9 if sprint else 1.0)
            self.cool -= dt
            if (self.firing or "space" in k) and self.cool <= 0:
                self.cool = 0.16
                self.fire(self.pa)
        else:
            self.drive_player(dt)
            self.px, self.py = self.car["x"], self.car["y"]
            self.walking = False
            self.cool -= dt
            if (self.firing or "space" in k) and self.cool <= 0:
                self.cool = 0.3
                self.fire(self.car["a"])

    def drive_player(self, dt):
        c = self.car
        k = self.keys
        sprint = "shift_l" in k or "shift_r" in k
        fwd = "w" in k or "up" in k
        back = "s" in k or "down" in k
        c["brake"] = back
        if fwd:
            c["v"] += 260 * dt
        elif back:
            c["v"] -= (300 if c["v"] > 10 else 120) * dt
        else:
            c["v"] *= (1 - 0.6 * dt)
        c["v"] = clamp(c["v"], -130, 470 if sprint else 330)
        steer = (1 if ("d" in k or "right" in k) else 0) - (1 if ("a" in k or "left" in k) else 0)
        if steer and abs(c["v"]) > 3:
            sign = 1 if c["v"] > 0 else -1
            c["a"] += steer * sign * 2.4 * dt * min(1.0, abs(c["v"]) / 140)
        c["v"] *= (1 - 0.1 * dt)

        # Kayma izi (hızlı dönüşte)
        self.skid_t -= dt
        if steer and abs(c["v"]) > 180 and self.skid_t <= 0:
            self.skid_t = 0.03
            rx, ry = local_pt(c["x"], c["y"], c["a"], -16, 9)
            lx, ly = local_pt(c["x"], c["y"], c["a"], -16, -9)
            self.skids.append([rx, ry, 0.0])
            self.skids.append([lx, ly, 0.0])

        v0 = abs(c["v"])
        if not self.drive(c, dt):
            if v0 > 100:
                c["hp"] -= 2
                self.explode(c["x"], c["y"], 6)
                self.hurt(3)
        if c["hp"] <= 0 and self.car is c:
            self.car_wreck()

    def fire(self, a):
        self.shot_t = self.t
        self.bullets.append({"x": self.px + math.cos(a) * 14, "y": self.py + math.sin(a) * 14,
                             "dx": math.cos(a) * 760, "dy": math.sin(a) * 760,
                             "life": 0.9, "by": "p"})

    def update_world(self, dt):
        self.update_cars(dt)
        self.update_peds(dt)
        self.update_bullets(dt)
        self.update_coins()
        self.update_wanted(dt)
        self.check_mission()
        self.spawn_stuff(dt)
        self.skids = [[x, y, a + dt] for x, y, a in self.skids if a + dt < 2.5]

    def update_cars(self, dt):
        for c in self.cars:
            if c["kind"] == "traffic":
                c["x"] += math.cos(c["a"]) * c["v"] * dt
                c["y"] += math.sin(c["a"]) * c["v"] * dt
                if c["x"] < -2 * TS:
                    c["x"] = (MW + 1) * TS
                elif c["x"] > (MW + 2) * TS:
                    c["x"] = -TS
                if c["y"] < -2 * TS:
                    c["y"] = (MH + 1) * TS
                elif c["y"] > (MH + 2) * TS:
                    c["y"] = -TS
            elif c["kind"] == "police":
                self.update_police(c, dt)
        self.cars = [c for c in self.cars if not c.get("gone")]

        if self.car is not None:
            c = self.car
            for o in list(self.cars):
                d = math.hypot(o["x"] - c["x"], o["y"] - c["y"])
                if d < 26 and abs(c["v"]) > 60:
                    o["hp"] -= abs(c["v"]) * dt * 0.06
                    c["v"] *= 0.7
                    if o["hp"] <= 0:
                        self.destroy_car(o)

    def update_police(self, c, dt):
        dxp = self.px - c["x"]
        dyp = self.py - c["y"]
        d = math.hypot(dxp, dyp)
        if d > 1100 and self.wanted == 0:
            c["gone"] = True
            return
        want = math.atan2(dyp, dxp)
        c["a"] += clamp(angdiff(c["a"], want), -2.5 * dt, 2.5 * dt)
        c["v"] = min(c["v"] + 260 * dt, 150 + self.wanted * 15)
        if not self.drive(c, dt, 14):
            c["a"] += self.rnd.choice((-1.4, 1.4))
            c["v"] = 120
        c["cool"] = c.get("cool", 1.0) - dt
        if d < 300 and c["cool"] <= 0 and self.down_t <= 0:
            c["cool"] = self.rnd.uniform(0.9, 1.6)
            a = want + self.rnd.uniform(-0.12, 0.12)
            self.bullets.append({"x": c["x"], "y": c["y"], "dx": math.cos(a) * 460,
                                 "dy": math.sin(a) * 460, "life": 1.2, "by": "e"})
        if d < 24 and self.down_t <= 0:
            self.hurt(14 * dt)
            c["v"] *= 0.5

    def destroy_car(self, o):
        if o not in self.cars:
            return
        self.cars.remove(o)
        self.explode(o["x"], o["y"], 26)
        if o["kind"] == "police":
            self.cash += 250
            self.say("Polis aracı imha edildi!  +$250")
        else:
            self.add_wanted(1)

    def car_wreck(self):
        c = self.car
        self.explode(c["x"], c["y"], 30, cols=("#ff7b00", "#ffd166", "#ff3d3d", "#2b2b2b"))
        self.car = None
        self.hurt(60)

    def update_peds(self, dt):
        for p in self.peds:
            if p["dead"]:
                continue
            p["t"] -= dt
            if p["t"] <= 0:
                p["a"] = self.rnd.uniform(0, math.tau)
                p["t"] = self.rnd.uniform(1.5, 4)
            fleeing = self.wanted > 0 and math.hypot(p["x"] - self.px, p["y"] - self.py) < 160
            sp = p["sp"]
            if fleeing:
                p["a"] = math.atan2(p["y"] - self.py, p["x"] - self.px)
                sp = 110
            nx = p["x"] + math.cos(p["a"]) * sp * dt
            ny = p["y"] + math.sin(p["a"]) * sp * dt
            if self.blocked(nx, ny, 6):
                p["a"] += math.pi
            else:
                p["x"], p["y"] = nx, ny
            if self.car is not None and abs(self.car["v"]) > 70:
                if math.hypot(p["x"] - self.car["x"], p["y"] - self.car["y"]) < 20:
                    p["dead"] = True
                    self.add_wanted(1)
                    self.explode(p["x"], p["y"], 8, cols=("#b00020", "#ff4d4d", "#6b6f78"))
        self.peds = [p for p in self.peds if not p["dead"]]
        if len(self.peds) < 60 and self.rnd.random() < 0.02:
            self.peds.append(self.new_ped())

    def update_bullets(self, dt):
        alive = []
        for b in self.bullets:
            b["life"] -= dt
            b["x"] += b["dx"] * dt
            b["y"] += b["dy"] * dt
            if b["life"] <= 0 or self.solid(b["x"], b["y"]):
                continue
            hit = False
            if b["by"] == "p":
                for p in self.peds:
                    if math.hypot(p["x"] - b["x"], p["y"] - b["y"]) < 10:
                        p["dead"] = True
                        hit = True
                        self.add_wanted(1)
                        self.explode(p["x"], p["y"], 8, cols=("#b00020", "#ff4d4d", "#6b6f78"))
                        break
                if not hit:
                    for c in list(self.cars):
                        if math.hypot(c["x"] - b["x"], c["y"] - b["y"]) < 18:
                            c["hp"] -= 1
                            hit = True
                            self.explode(b["x"], b["y"], 3)
                            if c["hp"] <= 0:
                                self.destroy_car(c)
                            break
            else:
                if self.down_t <= 0 and math.hypot(self.px - b["x"], self.py - b["y"]) < 14:
                    hit = True
                    if self.car is not None:
                        self.car["hp"] -= 6
                        self.hurt(3)
                        if self.car is not None and self.car["hp"] <= 0:
                            self.car_wreck()
                    else:
                        self.hurt(8)
            if not hit:
                alive.append(b)
        self.bullets = alive

    def update_coins(self):
        ref = (self.px, self.py)
        for i, co in enumerate(self.coins):
            if math.hypot(co["x"] - ref[0], co["y"] - ref[1]) < 22:
                self.cash += 15
                self.explode(co["x"], co["y"], 5, cols=(C_YELLOW, "#fff3b0"))
                self.coins[i] = self.new_coin()

    def update_wanted(self, dt):
        cops_near = any(c["kind"] == "police" and
                        math.hypot(c["x"] - self.px, c["y"] - self.py) < 420
                        for c in self.cars)
        if cops_near or self.t - self.shot_t < 2.5:
            self.heat = 0.0
        elif self.wanted > 0:
            self.heat += dt
            if self.heat > 10:
                self.wanted -= 1
                self.heat = 0.0

    def add_wanted(self, n):
        self.wanted = min(MAX_WANTED, self.wanted + n)
        self.heat = 0.0

    def spawn_stuff(self, dt):
        target = min(6, self.wanted * 2)
        cops = [c for c in self.cars if c["kind"] == "police"]
        self.police_t -= dt
        if len(cops) < target and self.police_t <= 0 and self.down_t <= 0:
            self.police_t = 2.5
            a = self.rnd.uniform(0, math.tau)
            x = self.px + math.cos(a) * 520
            y = self.py + math.sin(a) * 520
            if not self.blocked(x, y, 14):
                self.cars.append({"kind": "police", "x": x, "y": y, "a": a + math.pi,
                                  "v": 120.0, "col": C_POLICE, "hp": 4.0, "cool": 1.0,
                                  "brake": False})
        traffic = sum(1 for c in self.cars if c["kind"] == "traffic")
        if traffic < 38 and self.rnd.random() < 0.02:
            self.cars.append(self.new_traffic())

    def check_mission(self):
        mx, my = self.mission
        if math.hypot(self.px - mx, self.py - my) < 36:
            self.cash += self.mission_reward
            self.say("Görev tamamlandı!  +$%d" % self.mission_reward)
            self.explode(mx, my, 24, cols=(C_YELLOW, "#ffffff", "#ff7b00"))
            self.new_mission()

    def update_fx(self, dt):
        alive = []
        for p in self.parts:
            p["life"] -= dt
            if p["life"] > 0:
                p["x"] += p["dx"] * dt
                p["y"] += p["dy"] * dt
                p["dx"] *= 0.92
                p["dy"] *= 0.92
                alive.append(p)
        self.parts = alive

    def hurt(self, amt):
        if self.down_t > 0:
            return
        self.hp -= amt
        if self.hp <= 0:
            self.hp = 0
            self.die()

    def die(self):
        self.leave_car()
        self.cash = int(self.cash * 0.5)
        self.wanted = 0
        self.down_t = 3.5
        self.say("WASTED  -  paranın yarısını kaybettin", 3.5)

    def respawn(self):
        self.px, self.py = self.free_point(road=True)
        self.hp = 100.0
        self.cars = [c for c in self.cars if c["kind"] != "police"]
        self.bullets = []
        self.say("Hastanede uyandın")

    # ----- çizim -----
    def render(self):
        cv = self.cv
        cv.delete("all")
        self.w = max(cv.winfo_width(), 2)
        self.h = max(cv.winfo_height(), 2)
        cam_x, cam_y = self.cam_x, self.cam_y

        x0 = max(0, int(cam_x // TS))
        x1 = min(MW - 1, int((cam_x + self.w) // TS))
        y0 = max(0, int(cam_y // TS))
        y1 = min(MH - 1, int((cam_y + self.h) // TS))

        # 1) Zemin: yollar, kaldırımlar
        for ty in range(y0, y1 + 1):
            for tx in range(x0, x1 + 1):
                t = self.tiles[ty][tx]
                if t in (BLDG, PARK):
                    continue                       # blok olarak aşağıda çizilir
                sx = tx * TS - cam_x
                sy = ty * TS - cam_y
                if t == ROAD:
                    col = C_ROAD if (tx + ty) % 2 else C_ROAD_ALT
                    cv.create_rectangle(sx, sy, sx + TS, sy + TS, fill=col, outline="")
                    lx, ly = tx % BLK, ty % BLK
                    if ly == 0 and lx >= 2 and tx % 2 == 0:
                        cv.create_line(sx + 6, sy + TS, sx + TS - 6, sy + TS,
                                       fill=C_LANE, width=2)
                    if lx == 0 and ly >= 2 and ty % 2 == 0:
                        cv.create_line(sx + TS, sy + 6, sx + TS, sy + TS - 6,
                                       fill=C_LANE, width=2)
                else:
                    cv.create_rectangle(sx, sy, sx + TS, sy + TS, fill=C_WALK, outline="")
                    cv.create_line(sx, sy + TS, sx + TS, sy + TS, fill=C_WALK_JOINT)
                    cv.create_line(sx + TS, sy, sx + TS, sy + TS, fill=C_WALK_JOINT)

        # 2) Bloklar: binalar ve parklar
        bx0 = max(0, int(cam_x // (BLK * TS)) - 1)
        bx1 = min(NB - 1, int((cam_x + self.w) // (BLK * TS)) + 1)
        by0 = max(0, int(cam_y // (BLK * TS)) - 1)
        by1 = min(NB - 1, int((cam_y + self.h) // (BLK * TS)) + 1)
        for by in range(by0, by1 + 1):
            for bx in range(bx0, bx1 + 1):
                self.draw_block(bx, by, self.blocks[(bx, by)])

        # 3) Kayma izleri
        for x, y, age in self.skids:
            sx, sy = x - cam_x, y - cam_y
            cv.create_oval(sx - 2, sy - 2, sx + 2, sy + 2, fill="#14161c", outline="")

        # 4) Paralar
        for co in self.coins:
            sx, sy = co["x"] - cam_x, co["y"] - cam_y
            if -20 < sx < self.w + 20 and -20 < sy < self.h + 20:
                squash = 0.35 + 0.65 * abs(math.cos(self.t * 3 + co["ph"]))
                r = 6
                cv.create_oval(sx - r * squash, sy - r, sx + r * squash, sy + r,
                               fill=C_YELLOW, outline="#b8860b")

        # 5) Arabalar
        for c in self.cars:
            self.draw_car(c)
        if self.car is not None:
            self.draw_car(self.car)

        # 6) İnsanlar
        for p in self.peds:
            sx, sy = p["x"] - cam_x, p["y"] - cam_y
            if -20 < sx < self.w + 20 and -20 < sy < self.h + 20:
                bob = math.sin(self.t * 9 + p["ph"]) * 0.8 if p["sp"] > 0 else 0.0
                self.draw_person(sx, sy, p["a"], p["shirt"], p["skin"], bob)

        if self.down_t <= 0 and self.car is None:
            sx, sy = self.px - cam_x, self.py - cam_y
            bob = math.sin(self.walk_t * 12) * 1.2 if self.walking else 0.0
            self.draw_person(sx, sy, self.pa, "#ff7b54", "#f1c27d", bob, big=True)
            ex, ey = local_pt(sx, sy, self.pa, 8, 0)
            cv.create_line(ex, ey, ex + math.cos(self.pa) * 9, ey + math.sin(self.pa) * 9,
                           fill="#2b2b2b", width=3)

        # 7) Mermiler
        for b in self.bullets:
            sx, sy = b["x"] - cam_x, b["y"] - cam_y
            if b["by"] == "p":
                col = "#fff3a0"
            else:
                col = "#ff5252"
            tail_x = sx - b["dx"] * 0.03
            tail_y = sy - b["dy"] * 0.03
            cv.create_line(tail_x, tail_y, sx, sy, fill=col, width=2)

        # 8) Parçacıklar
        for p in self.parts:
            sx, sy = p["x"] - cam_x, p["y"] - cam_y
            r = p["r"] * clamp(p["life"] / 0.8, 0.3, 1.0)
            cv.create_oval(sx - r, sy - r, sx + r, sy + r, fill=p["col"], outline="")

        self.draw_mission()
        self.draw_hud()

    def draw_block(self, bx, by, info):
        cv = self.cv
        cam_x, cam_y = self.cam_x, self.cam_y
        x0 = (bx * BLK + 3) * TS - cam_x
        x1 = (bx * BLK + 9) * TS - cam_x
        y0 = (by * BLK + 3) * TS - cam_y
        y1 = (by * BLK + 9) * TS - cam_y
        s = info["seed"]
        if info["kind"] == BLDG:
            cv.create_rectangle(x0 + 6, y0 + 8, x1 + 6, y1 + 8, fill=C_BLD_SHADOW, outline="")
            cv.create_rectangle(x0, y0, x1, y1, fill=shade(info["wall"], 0.7), outline="")
            cv.create_rectangle(x0 + 4, y0 + 4, x1 - 4, y1 - 4, fill=info["roof"], outline="")
            cv.create_line(x0 + 4, y1 - 4, x1 - 4, y1 - 4, fill=shade(info["roof"], 0.7), width=3)
            cv.create_line(x1 - 4, y0 + 4, x1 - 4, y1 - 4, fill=shade(info["roof"], 0.7), width=3)
            for i in range(3):
                bxp = x0 + 24 + ((s * (i + 3) * 17) % 5) * 36
                byp = y0 + 24 + ((s * (i + 7) * 13) % 5) * 36
                cv.create_rectangle(bxp, byp, bxp + 18, byp + 12,
                                    fill=shade(info["roof"], 0.75),
                                    outline=shade(info["roof"], 0.55))
        else:
            cv.create_rectangle(x0, y0, x1, y1, fill=C_GRASS, outline="")
            cv.create_rectangle(x0 + 8, y0 + 8, x1 - 8, y1 - 8, fill=C_GRASS_ALT, outline="")
            mx = (x0 + x1) / 2
            my = (y0 + y1) / 2
            cv.create_rectangle(mx - 4, y0 + 8, mx + 4, y1 - 8, fill=C_PATH, outline="")
            cv.create_rectangle(x0 + 8, my - 4, x1 - 8, my + 4, fill=C_PATH, outline="")
            for i in range(5):
                tx = x0 + 28 + ((s * (i + 2) * 37) % 180)
                ty = y0 + 28 + ((s * (i + 5) * 53) % 180)
                r = 13 + (i % 3) * 3
                cv.create_oval(tx - r + 5, ty - r + 6, tx + r + 5, ty + r + 6,
                               fill=C_SHADOW, outline="")
                cv.create_oval(tx - r, ty - r, tx + r, ty + r, fill=C_TREE,
                               outline=shade(C_TREE, 0.7))
                cv.create_oval(tx - r * 0.55, ty - r * 0.6, tx + r * 0.15, ty + r * 0.05,
                               fill=C_TREE_HI, outline="")

    def draw_car(self, c):
        cv = self.cv
        sx, sy = c["x"] - self.cam_x, c["y"] - self.cam_y
        if sx < -60 or sx > self.w + 60 or sy < -60 or sy > self.h + 60:
            return
        a = c["a"]
        L, W = 20, 11
        col = c["col"]
        cv.create_oval(sx - L - 1, sy - W + 3, sx + L + 4, sy + W + 6, fill=C_SHADOW, outline="")
        cv.create_polygon(rot_rect(sx, sy, a, L, W), fill=col, outline=shade(col, 0.55))
        rx, ry = local_pt(sx, sy, a, -2, 0)
        cv.create_polygon(rot_rect(rx, ry, a, L * 0.5, W * 0.78),
                          fill=shade(col, 1.15), outline="")
        fx, fy = local_pt(sx, sy, a, 7, 0)
        cv.create_polygon(rot_rect(fx, fy, a, 4, W * 0.6), fill="#8fc7f0", outline="")
        bxr, byr = local_pt(sx, sy, a, -8, 0)
        cv.create_polygon(rot_rect(bxr, byr, a, 3, W * 0.55), fill="#6aa7d4", outline="")
        for side in (-1, 1):
            hx, hy = local_pt(sx, sy, a, L - 2, side * (W - 3))
            cv.create_oval(hx - 2.5, hy - 2.5, hx + 2.5, hy + 2.5, fill="#fff7c2", outline="")
            tlx, tly = local_pt(sx, sy, a, -L + 1, side * (W - 3))
            tcol = "#ff3b3b" if c.get("brake") else "#7a1010"
            cv.create_oval(tlx - 2, tly - 2, tlx + 2, tly + 2, fill=tcol, outline="")
        if c["kind"] == "police":
            lc = "#ff2a2a" if int(self.t * 8) % 2 else "#2a7bff"
            lc2 = "#2a7bff" if lc == "#ff2a2a" else "#ff2a2a"
            lx, ly = local_pt(sx, sy, a, 0, 4)
            rx2, ry2 = local_pt(sx, sy, a, 0, -4)
            cv.create_rectangle(lx - 3, ly - 3, lx + 3, ly + 3, fill=lc, outline="")
            cv.create_rectangle(rx2 - 3, ry2 - 3, rx2 + 3, ry2 + 3, fill=lc2, outline="")

    def draw_person(self, sx, sy, a, shirt, skin, bob=0.0, big=False):
        cv = self.cv
        r = 8 if big else 6
        cv.create_oval(sx - r - 2, sy - r / 2 + 3, sx + r + 2, sy + r / 2 + 5,
                       fill=C_SHADOW, outline="")
        by = sy + bob
        cv.create_oval(sx - r, by - r, sx + r, by + r, fill=shirt,
                       outline=shade(shirt, 0.55))
        hx, hy = sx + math.cos(a) * r * 0.2, by + math.sin(a) * r * 0.2
        hr = r * 0.55
        cv.create_oval(hx - hr, hy - hr, hx + hr, hy + hr, fill=skin, outline="")

    def draw_mission(self):
        cv = self.cv
        mx, my = self.mission
        sx, sy = mx - self.cam_x, my - self.cam_y
        if 0 <= sx <= self.w and 0 <= sy <= self.h:
            r = 18 + 4 * math.sin(self.t * 6)
            cv.create_oval(sx - r, sy - r, sx + r, sy + r, outline=C_YELLOW, width=3)
            cv.create_oval(sx - 5, sy - 5, sx + 5, sy + 5, fill=C_YELLOW, outline="")
        else:
            dx, dy = sx - self.w / 2, sy - self.h / 2
            n = math.hypot(dx, dy) or 1.0
            edge = min(self.w, self.h) / 2 - 70
            ex, ey = self.w / 2 + dx / n * edge, self.h / 2 + dy / n * edge
            ang = math.atan2(dy, dx)
            tip = (ex + math.cos(ang) * 14, ey + math.sin(ang) * 14)
            left = (ex + math.cos(ang + 2.5) * 10, ey + math.sin(ang + 2.5) * 10)
            right = (ex + math.cos(ang - 2.5) * 10, ey + math.sin(ang - 2.5) * 10)
            cv.create_polygon(tip[0], tip[1], left[0], left[1], right[0], right[1],
                              fill=C_YELLOW, outline="#000000")

    def panel(self, x0, y0, x1, y1):
        self.cv.create_rectangle(x0 + 2, y0 + 3, x1 + 2, y1 + 3, fill="#07090d", outline="")
        self.cv.create_rectangle(x0, y0, x1, y1, fill=C_HUD, outline=C_HUD_EDGE, width=1)

    def draw_hud(self):
        cv = self.cv
        w, h = self.w, self.h

        # Sol üst: can, para, arama
        self.panel(14, 14, 262, 140)
        cv.create_text(28, 30, anchor="w", text="CAN", fill=C_MUTED, font=("Segoe UI", 9, "bold"))
        cv.create_rectangle(28, 42, 248, 54, fill="#1a1f2a", outline="")
        frac = clamp(self.hp / 100, 0, 1)
        hc = "#2ecc71" if frac > 0.5 else "#f1c40f" if frac > 0.25 else "#e74c3c"
        cv.create_rectangle(28, 42, 28 + 220 * frac, 54, fill=hc, outline="")
        money = "{:,}".format(self.cash).replace(",", ".")
        cv.create_text(29, 74, anchor="w", text="$ " + money, fill="#000000",
                       font=("Segoe UI", 19, "bold"))
        cv.create_text(28, 73, anchor="w", text="$ " + money, fill=C_YELLOW,
                       font=("Segoe UI", 19, "bold"))
        stars = "\u2605" * self.wanted + "\u2606" * (MAX_WANTED - self.wanted)
        cv.create_text(28, 116, anchor="w", text="ARANIYOR", fill=C_MUTED,
                       font=("Segoe UI", 9, "bold"))
        cv.create_text(120, 116, anchor="w", text=stars, fill="#ff5c8a", font=("Segoe UI", 13))

        # Üst orta: görev ve mesaj
        self.panel(w / 2 - 230, 14, w / 2 + 230, 58)
        cv.create_text(w / 2, 28, text="GÖREV", fill=C_MUTED, font=("Segoe UI", 8, "bold"))
        cv.create_text(w / 2, 46,
                       text="İşaretli yere git  •  ödül $%d" % self.mission_reward,
                       fill=C_YELLOW, font=("Segoe UI", 11, "bold"))
        if self.msg_t > 0:
            cv.create_text(w / 2 + 1, 81, text=self.msg, fill="#000000",
                           font=("Segoe UI", 15, "bold"))
            cv.create_text(w / 2, 80, text=self.msg, fill=C_TEXT,
                           font=("Segoe UI", 15, "bold"))

        # Araç hızı
        if self.car is not None:
            kmh = int(abs(self.car["v"]) * 0.5)
            self.panel(14, 152, 262, 202)
            cv.create_text(28, 168, anchor="w", text="ARAÇ", fill=C_MUTED,
                           font=("Segoe UI", 9, "bold"))
            cv.create_text(248, 168, anchor="e", text="%d km/s" % kmh, fill="#22d3ee",
                           font=("Segoe UI", 11, "bold"))
            cv.create_rectangle(28, 182, 248, 190, fill="#1a1f2a", outline="")
            cv.create_rectangle(28, 182, 28 + 220 * clamp(abs(self.car["v"]) / 470, 0, 1), 190,
                                fill="#22d3ee", outline="")

        # Ölüm yazısı
        if self.down_t > 0:
            cv.create_text(w / 2 + 3, h / 2 + 3, text="WASTED", fill="#000000",
                           font=("Segoe UI", 54, "bold"))
            cv.create_text(w / 2, h / 2, text="WASTED", fill="#ff3b3b",
                           font=("Segoe UI", 54, "bold"))

        # Alt: kontroller ve FPS
        self.panel(14, h - 58, 780, h - 14)
        cv.create_text(28, h - 36, anchor="w", fill=C_MUTED, font=("Segoe UI", 10),
                       text="WASD hareket  •  Fare nişan  •  Sol tık / Boşluk ateş  •  "
                            "E araç  •  Shift koş  •  ESC çık")
        cv.create_text(w - 14, h - 14, anchor="se", text="%d FPS" % self.fps,
                       fill="#7dffb3", font=("Consolas", 9))

        # Mini harita
        mx0, my0 = w - 200, h - 200
        self.panel(mx0 - 10, my0 - 10, mx0 + 190, my0 + 190)
        cv.create_image(mx0, my0, anchor="nw", image=self.mini)
        px = mx0 + self.px / TS * 2
        py = my0 + self.py / TS * 2
        cv.create_oval(px - 4, py - 4, px + 4, py + 4, fill="#ffffff", outline="#000000")
        mxm = mx0 + self.mission[0] / TS * 2
        mym = my0 + self.mission[1] / TS * 2
        cv.create_oval(mxm - 4, mym - 4, mxm + 4, mym + 4, fill=C_YELLOW, outline="#000000")

    # ----- döngü -----
    def loop(self):
        if self.dead:
            return
        now = time.perf_counter()
        dt = min(0.05, now - self.last)
        self.last = now
        try:
            self.update(dt)
            self.render()
        except tk.TclError:
            return                      # pencere kapandıysa çık
        except Exception:
            import traceback
            traceback.print_exc()       # hatayı launcher logunda görünür yap
            return
        self.fps = self.fps * 0.9 + (1.0 / max(dt, 1e-3)) * 0.1
        self.win.after(16, self.loop)


def play(root):
    Game(root)
