import tkinter as tk
from tkinter import filedialog, messagebox
import urllib.request
import threading
import queue
import ctypes
import os
import subprocess
import sys

URL = "https://raw.githubusercontent.com/scpstudioofficaltr-spec/load-system-by-crgame/refs/heads/main/file1.py"
ICON_URL = "https://github.com/scpstudioofficaltr-spec/load-system-by-crgame/raw/refs/heads/main/icoimg"

DOSYA_ADI = "file1.py"          # indirilen ana dosya
LAUNCHER_ADI = "CR-GAME.pyw"    # klasördeki başlatıcı (.pyw)
ICO_ADI = "CR-GAME.ico"         # klasördeki ikon
KISAYOL_ADI = "CR-GAME.lnk"     # masaüstündeki kısayol

LAUNCHER_KODU = '''import os
import sys
import runpy

klasor = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, klasor)
runpy.run_path(os.path.join(klasor, "file1.py"), run_name="__main__")
'''

BG = "#f0f0f0"
BUTON = "#e1e1e1"
TRACK = "#e4e4e4"
TRACK_BORDER = "#b9b9b9"
GREEN = "#06b025"
TEXT = "#1f1f1f"
SUB_TEXT = "#4a4a4a"
BAR_W = 384
BAR_H = 16
NO_WINDOW = getattr(subprocess, "CREATE_NO_WINDOW", 0)


def kb(n):
    return f"{n // 1024:,}"


def pencereyi_ortala(root, genislik, yukseklik):
    x = root.winfo_screenwidth() // 2 - genislik // 2
    y = root.winfo_screenheight() // 2 - yukseklik // 2
    root.geometry(f"{genislik}x{yukseklik}+{x}+{y}")


def ps_metin(s):
    """PowerShell için tek tırnaklı, güvenli metin."""
    return "'" + s.replace("'", "''") + "'"


def masaustu_yolu():
    try:
        buf = ctypes.create_unicode_buffer(260)
        # CSIDL_DESKTOPDIRECTORY = 0x10
        ctypes.windll.shell32.SHGetFolderPathW(0, 0x10, 0, 0, buf)
        if buf.value:
            return buf.value
    except Exception:
        pass
    return os.path.join(os.path.expanduser("~"), "Desktop")


def pythonw_yolu():
    p = sys.executable
    adayi = os.path.join(os.path.dirname(p), "pythonw.exe")
    return adayi if os.path.exists(adayi) else p


def ico_indir(yol):
    """İkonu indirir. ICO değilse False döner, kısayol varsayılan ikonla oluşur."""
    try:
        req = urllib.request.Request(ICON_URL, headers={"User-Agent": "Mozilla/5.0"})
        veri = urllib.request.urlopen(req, timeout=15).read()
        if veri[:4] != b"\x00\x00\x01\x00":
            return False
        with open(yol, "wb") as f:
            f.write(veri)
        return True
    except Exception:
        return False


def kisayol_olustur(klasor, pyw, ico_yolu):
    """Masaüstüne, .pyw dosyasını çalıştıran logolu kısayol oluşturur."""
    lnk = os.path.join(masaustu_yolu(), KISAYOL_ADI)
    satirlar = [
        f"$s = (New-Object -ComObject WScript.Shell).CreateShortcut({ps_metin(lnk)})",
        f"$s.TargetPath = {ps_metin(pythonw_yolu())}",
        f"$s.Arguments = {ps_metin(chr(34) + pyw + chr(34))}",
        f"$s.WorkingDirectory = {ps_metin(klasor)}",
    ]
    if ico_yolu:
        satirlar.append(f"$s.IconLocation = {ps_metin(ico_yolu + ',0')}")
    satirlar.append("$s.Save()")
    try:
        subprocess.run(
            ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "; ".join(satirlar)],
            capture_output=True, timeout=30, creationflags=NO_WINDOW,
        )
    except Exception:
        return False
    return os.path.exists(lnk)


def uygulamayi_baslat(pyw, klasor):
    try:
        subprocess.Popen([pythonw_yolu(), pyw], cwd=klasor)
    except Exception:
        pass


class SecimEkrani:
    """Başlangıç ekranı: 'Dosya Seç' butonu, basınca Gözat penceresi açılır."""

    def __init__(self, root, bitince):
        self.root = root
        self.bitince = bitince
        self.secilen = None

        root.title("CR-GAME INSTALLING")
        root.configure(bg=BG)
        root.resizable(False, False)
        pencereyi_ortala(root, 420, 150)

        tk.Label(root, text="Kurulum klasörünü seçin", bg=BG, fg=TEXT,
                 font=("Segoe UI", 10)).pack(pady=(22, 8))

        self.lbl_yol = tk.Label(root, text="Henüz klasör seçilmedi", bg=BG, fg=SUB_TEXT,
                                font=("Segoe UI", 9), wraplength=380)
        self.lbl_yol.pack(pady=(0, 12))

        alt = tk.Frame(root, bg=BG)
        alt.pack(fill="x", padx=18)

        tk.Button(alt, text="Dosya Seç", width=12, font=("Segoe UI", 9),
                  relief="groove", bg=BUTON, command=self.dosya_sec).pack(side="left")

        self.btn_devam = tk.Button(alt, text="Devam", width=12, font=("Segoe UI", 9),
                                   relief="groove", bg=BUTON, state="disabled",
                                   command=self.devam)
        self.btn_devam.pack(side="right")

        root.protocol("WM_DELETE_WINDOW", root.destroy)

    def dosya_sec(self):
        klasor = filedialog.askdirectory(title="Kurulum klasörünü seç", parent=self.root)
        if klasor:
            self.secilen = klasor
            self.lbl_yol.config(text=klasor)
            self.btn_devam.config(state="normal")

    def devam(self):
        if self.secilen:
            self.bitince(os.path.join(self.secilen, "CrGameSistem"))


class TamamlaEkrani:
    """Kurulum sonrası ayarlar ve Tamamla butonu."""

    def __init__(self, root, klasor, pyw, kisayol_ok):
        self.root = root
        self.klasor = klasor
        self.pyw = pyw
        self.bitti = False

        root.title("CR-GAME INSTALLING")
        root.configure(bg=BG)
        pencereyi_ortala(root, 420, 220)

        tk.Label(root, text="Kurulum tamamlandı", bg=BG, fg=TEXT,
                 font=("Segoe UI", 11, "bold")).pack(pady=(18, 4))

        kisayol_metni = ("Masaüstü kısayolu oluşturuldu." if kisayol_ok
                         else "Masaüstü kısayolu oluşturulamadı.")
        tk.Label(root, text=kisayol_metni, bg=BG, fg=SUB_TEXT,
                 font=("Segoe UI", 9)).pack(pady=(0, 12))

        self.var_tamamla = tk.BooleanVar(value=True)
        self.var_kapat = tk.BooleanVar(value=True)

        for metin, var in (
            ("Tamamla butonuna basınca uygulamayı başlat", self.var_tamamla),
            ("Pencere kapatılınca uygulamayı başlat", self.var_kapat),
        ):
            tk.Checkbutton(root, text=metin, variable=var, bg=BG, fg=TEXT,
                           activebackground=BG, selectcolor="white",
                           font=("Segoe UI", 9)).pack(anchor="w", padx=40)

        alt = tk.Frame(root, bg=BG)
        alt.pack(fill="x", padx=18, pady=(16, 0))
        tk.Button(alt, text="Tamamla", width=12, font=("Segoe UI", 9),
                  relief="groove", bg=BUTON,
                  command=lambda: self.bitir(self.var_tamamla.get())).pack(side="right")

        root.protocol("WM_DELETE_WINDOW", lambda: self.bitir(self.var_kapat.get()))

    def bitir(self, baslat):
        if self.bitti:
            return
        self.bitti = True
        if baslat:
            uygulamayi_baslat(self.pyw, self.klasor)
        self.root.destroy()


class CRGameInstaller:
    """Yükleme ekranı: ilerleme çubuğu, KB sayacı ve İptal butonu."""

    def __init__(self, root):
        self.root = root
        self.kuyruk = queue.Queue()
        self.iptal_olay = threading.Event()
        self.indiriliyor = False

        root.title("CR-GAME INSTALLING")
        root.configure(bg=BG)
        root.resizable(False, False)
        pencereyi_ortala(root, 420, 150)

        ust = tk.Frame(root, bg=BG)
        ust.pack(fill="x", padx=18, pady=(16, 0))
        tk.Label(ust, text="CR-GAME Installing...", bg=BG, fg=TEXT,
                 font=("Segoe UI", 10)).pack(anchor="w")

        self.canvas = tk.Canvas(root, width=BAR_W, height=BAR_H, bg=TRACK,
                                highlightthickness=1, highlightbackground=TRACK_BORDER)
        self.canvas.pack(padx=18, pady=(10, 0), anchor="w")

        alt = tk.Frame(root, bg=BG)
        alt.pack(fill="x", padx=18, pady=(8, 0))

        self.lbl_detay = tk.Label(alt, text="Hazırlanıyor...", bg=BG, fg=SUB_TEXT,
                                  font=("Segoe UI", 9))
        self.lbl_detay.pack(side="left", anchor="w")

        self.btn = tk.Button(alt, text="İptal", width=10, font=("Segoe UI", 9),
                             command=self.iptal_tikla, relief="groove", bg=BUTON)
        self.btn.pack(side="right")

        self.bar_ciz(0)
        self.root.after(50, self.kuyruk_isle)

    def bar_ciz(self, oran):
        self.canvas.delete("all")
        dolu = int(BAR_W * max(0.0, min(1.0, oran)))
        if dolu > 0:
            self.canvas.create_rectangle(0, 0, dolu, BAR_H, fill=GREEN, outline="")

    def indir(self, hedef_klasor):
        yol = None
        try:
            os.makedirs(hedef_klasor, exist_ok=True)

            # 1) İkon
            ico_yolu = os.path.join(hedef_klasor, ICO_ADI)
            ico_ok = ico_indir(ico_yolu)

            # 2) Ana dosya (file1.py), ilerleme çubuğu ile
            yol = os.path.join(hedef_klasor, DOSYA_ADI)
            req = urllib.request.Request(URL, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=15) as cevap:
                toplam = int(cevap.headers.get("Content-Length") or 0)
                indirilen = 0
                with open(yol, "wb") as f:
                    while True:
                        if self.iptal_olay.is_set():
                            f.close()
                            os.remove(yol)
                            self.kuyruk.put(("iptal", None))
                            return
                        parca = cevap.read(8192)
                        if not parca:
                            break
                        f.write(parca)
                        indirilen += len(parca)
                        self.kuyruk.put(("ilerleme", (indirilen, toplam)))

            # 3) Başlatıcı .pyw
            pyw = os.path.join(hedef_klasor, LAUNCHER_ADI)
            with open(pyw, "w", encoding="utf-8") as f:
                f.write(LAUNCHER_KODU)

            # 4) Masaüstü kısayolu
            kisayol_ok = kisayol_olustur(hedef_klasor, pyw, ico_yolu if ico_ok else None)

            self.kuyruk.put(("bitti", (hedef_klasor, pyw, kisayol_ok)))

        except Exception as e:
            if yol and os.path.exists(yol):
                try:
                    os.remove(yol)
                except OSError:
                    pass
            self.kuyruk.put(("hata", str(e)))

    def kuyruk_isle(self):
        try:
            while True:
                olay, veri = self.kuyruk.get_nowait()

                if olay == "ilerleme":
                    indirilen, toplam = veri
                    if toplam > 0:
                        self.bar_ciz(indirilen / toplam)
                        self.lbl_detay.config(
                            text=f"Güncelleme indiriliyor ({kb(indirilen)} / {kb(toplam)} KB)...")
                    else:
                        self.lbl_detay.config(
                            text=f"Güncelleme indiriliyor ({kb(indirilen)} KB)...")

                elif olay == "bitti":
                    self.bar_ciz(1.0)
                    self.tamamla_ekrani(*veri)
                    return

                elif olay == "iptal":
                    self.root.destroy()
                    return

                elif olay == "hata":
                    self.indiriliyor = False
                    self.lbl_detay.config(text="Hata oluştu.")
                    self.btn.config(text="Kapat", state="normal", command=self.root.destroy)
                    messagebox.showerror("Hata", f"İndirme sırasında hata oluştu:\n{veri}")
                    return

        except queue.Empty:
            pass
        self.root.after(50, self.kuyruk_isle)

    def tamamla_ekrani(self, klasor, pyw, kisayol_ok):
        for w in self.root.winfo_children():
            w.destroy()
        TamamlaEkrani(self.root, klasor, pyw, kisayol_ok)

    def iptal_tikla(self):
        if self.indiriliyor:
            self.iptal_olay.set()
            self.btn.config(state="disabled")
            self.lbl_detay.config(text="İptal ediliyor...")
        else:
            self.root.destroy()

    def baslat(self, hedef_klasor):
        self.indiriliyor = True
        self.lbl_detay.config(text="Güncelleme indiriliyor...")
        threading.Thread(target=self.indir, args=(hedef_klasor,), daemon=True).start()


def main():
    root = tk.Tk()

    def secim_bitti(hedef):
        for w in root.winfo_children():
            w.destroy()
        yukleme = CRGameInstaller(root)
        yukleme.baslat(hedef)

    SecimEkrani(root, secim_bitti)
    root.mainloop()


if __name__ == "__main__":
    main()
